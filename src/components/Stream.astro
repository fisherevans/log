---
// The stream: the site's single listing, posts and notes interleaved on one
// timeline. Rendered server-side including the year rail and the pager, so
// both are real links that work without JS (and so Astro's scoped styles
// actually reach them - scoped CSS is stamped at build time and never reaches
// anything built with innerHTML).
import type { StreamItem } from '../lib/stream';
import StreamEntry from './StreamEntry.astro';
import Pager from './Pager.astro';
import { groupBursts, previewOf, spanLabel, type StreamBlock } from '../lib/stream';
import { cfImage, isMediaUrl } from '../../plugins/media-urls.mjs';
import { fmtDate } from '../lib/search';

interface Props {
    // Either a flat list (folded into bursts here unless collapse is false)...
    items?: StreamItem[];
    // ...or blocks already cut into a page by pageOf(), with the number of
    // items on earlier pages so the pager's range can say "21-40 of 96".
    blocks?: StreamBlock[];
    offset?: number;
    collapse?: boolean;
    years: number[];
    activeYear?: number;
    page?: { current: number; last: number; hrefFor: (n: number) => string };
    total?: number;
    pageSize?: number;
    // The rail links to /posts/YYYY/, which drops any filter the caller applied
    // - so a tag page asks for it to be left off rather than offering a jump
    // that silently leaves the tag.
    showYears?: boolean;
}
const { items = [], years, activeYear, page, total, showYears = true, collapse = true, offset = 0 } = Astro.props;
const blocks: StreamBlock[] = Astro.props.blocks ?? (collapse ? groupBursts(items) : items.map((item) => ({ kind: 'entry' as const, item })));
const span = (a: StreamItem[]) => {
    const first = fmtDate(a[a.length - 1].date);
    const last = fmtDate(a[0].date);
    return first === last ? first : `${first} - ${last}`;
};
// The strip shows up to four previews; the fifth tile is the "+N" that opens
// the rest. A run with no pictures at all gets no strip - the text carries it.
const STRIP = 4;
// An opened burst reveals this many at a time; 38 notes at once takes over the
// page, and the footer's "Show 5 more · 33 left" keeps the reader in control.
const BURST_PAGE = 5;
const longDate = (d: Date) => d.toLocaleDateString('en-us', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
const thumb = (src: string) => (isMediaUrl(src) ? cfImage(src, 200) : src);
type Prev = NonNullable<ReturnType<typeof previewOf>>;
const previewsFor = (b: StreamBlock): Prev[] =>
    b.kind === 'burst' ? (b.rest.map(previewOf).filter(Boolean).slice(0, STRIP) as Prev[]) : [];
const playIcon =
    '<svg class="play" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="rgba(5,5,5,0.7)"/><path d="M9.5 7.5v9l7-4.5z" fill="#fff"/></svg>';
---

<div class="stream-wrap">
    {showYears && (
    <nav class="years" aria-label="Jump to year">
        <span class="years-inner">
            <a class="year" href="/posts/" aria-current={activeYear ? undefined : 'page'}>all</a>
            {
                years.map((y) => (
                    <a class="year" href={`/posts/${y}/`} data-year={y} aria-current={activeYear === y ? 'page' : undefined}>
                        {y}
                    </a>
                ))
            }
        </span>
    </nav>
    )}

    {page && page.last > 1 && page.current > 1 && <Pager page={page} />}

    <div class="stream">
        {blocks.map((b) =>
            b.kind === 'entry' ? (
                <StreamEntry item={b.item} />
            ) : (
                <>
                    {b.lead.map((item) => <StreamEntry item={item} />)}
                    <div class="burst" data-tag={b.tag}>
                        <div class="burst-card">
                            <div class="front">
                                <p class="burst-hl">
                                    <span class="n">{b.rest.length}</span> more {b.rest.length === 1 ? 'note' : 'notes'}
                                </p>
                                <p class="burst-meta">
                                    in <a href={`/tags/${b.tag}/`}>#{b.tag}</a>
                                    <span class="when"><span class="sep">·</span><time class="rel" datetime={b.rest[0].date.toISOString()} data-abs={longDate(b.rest[0].date)} title={longDate(b.rest[0].date)}>{fmtDate(b.rest[0].date)}</time><span class="sep">·</span><button type="button" class="burst-span" data-span={spanLabel(b.rest)} data-range={span(b.rest)} title={span(b.rest)}>{spanLabel(b.rest)}</button></span>
                                </p>
                                {previewsFor(b).length > 0 && (
                                    <div class="burst-strip">
                                        {previewsFor(b).map((p) => (
                                            <a class={p.video ? 'thumb video' : 'thumb'} href={p.href} title={p.video ? 'Video' : undefined}>
                                                <img src={thumb(p.src)} alt={p.alt} loading="lazy" decoding="async" />
                                                {p.video && <Fragment set:html={playIcon} />}
                                            </a>
                                        ))}
                                        {b.rest.length > previewsFor(b).length && (
                                            <button type="button" class="thumb more burst-open-alt" aria-label="View the notes">+{b.rest.length - previewsFor(b).length}</button>
                                        )}
                                    </div>
                                )}
                                <div class="burst-actions">
                                    <button type="button" class="burst-open" aria-expanded="false">View the notes</button>
                                    <a class="burst-tag" href={`/tags/${b.tag}/`}>Everything in #{b.tag}&nbsp;&rarr;</a>
                                </div>
                            </div>
                        </div>
                        <div class="burst-more" hidden data-page-size={BURST_PAGE}>
                            {b.rest.map((item) => <StreamEntry item={item} />)}
                            <div class="burst-end">
                                <button type="button" class="burst-page" hidden></button>
                                <button type="button" class="burst-close">Hide these {b.rest.length} #{b.tag} notes <span class="up" aria-hidden="true">&#8963;</span></button>
                            </div>
                        </div>
                    </div>
                </>
            ),
        )}
    </div>

    {page && page.last > 1 && <Pager page={page} />}
    {/* With JS the pagers become load-more: older pages append as you near the
        bottom, and from page 2 on a "newer" control prepends. The static pages
        stay underneath for no-JS, crawlers, and deep links. */}
</div>



<div id="lightbox" hidden>
    <button class="lb-close" type="button">Close &times;</button>
    <button class="lb-nav lb-prev" type="button" aria-label="Previous image">&lsaquo;</button>
    <img id="lb-img" src="" alt="" />
    <button class="lb-nav lb-next" type="button" aria-label="Next image">&rsaquo;</button>
    <p class="lb-cap" id="lb-cap"></p>
</div>

<style>
    /* ---------- the timeline ---------- */
    .stream-wrap { position: relative; }
    .stream {
        position: relative;
        /* Every offset below derives from these two, so the spine, the dots,
           the rings and the connector cannot drift apart. */
        /* The spine sits far enough in that the nodes drawn around it fall
           INSIDE each entry's box. content-visibility: auto (below) applies
           paint containment, which clips anything outside that box - which is
           why the gutter has to be padding on the entry, not margin. */
        --spine-x: 0.75rem;
        --spine-c: calc(var(--spine-x) + 0.5px);
        --item-indent: 1.9rem;
        --branch: color-mix(in srgb, var(--accent) 55%, transparent);
    }
    .stream::before {
        content: '';
        position: absolute;
        left: var(--spine-x);
        top: 0.5rem;
        bottom: 0.5rem;
        width: 1px;
        background: var(--rule);
    }
    /* Scroll anchoring keeps the view stable when content above changes size,
       which is exactly what fights an explicit restore. */
    .stream.is-restoring { overflow-anchor: none; }
    .stream :global(.entry) {
        padding-left: var(--item-indent);
        position: relative;
        /* NO content-visibility here, deliberately. It skips layout for
           off-screen entries and estimates their height, which breaks
           scroll restoration: coming back to an entry, the ones above it
           resolve to their real (taller) sizes as you pass them, pushing the
           target further down, and each correction chases it - measured
           landing at the document bottom instead of the entry. It also applies
           PAINT CONTAINMENT, which clipped the timeline nodes out of the
           gutter until the gutter became padding.
           The page is paginated at 20 entries and loads in ~230ms without it,
           so it was buying very little for two real bugs. */
        --ring-outer: 1.05rem;
        --ring-b: 2px;
        /* entry coordinates (the entry is the containing block) */
        --ring-left: calc(var(--spine-c) - (var(--ring-outer) / 2));
        /* frame coordinates, for anything drawn on .frame */
        --node-x: calc(var(--spine-c) - var(--item-indent));
    }
    .stream :global(.entry .frame) { position: relative; }

    /* ---------- notes ---------- */
    .stream :global(.entry.note) { margin-top: 2.8rem; margin-bottom: 2.8rem; }
    .stream :global(.entry.note .meta)::before {
        content: '';
        position: absolute;
        left: calc(var(--node-x) - 0.25rem);
        top: 0.42em;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 0.28rem var(--bg);
    }
    .stream :global(.entry.note .head) {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        margin: 0 0 0.3em;
    }
    .stream :global(.entry.note .head .right) { display: flex; align-items: baseline; gap: 0.9rem; flex: 0 0 auto; }
    /* Four actions on a phone would crush the date into two lines and the
       tag chips into a column; let the actions drop under instead. */
    @media (max-width: 40rem) {
        .stream :global(.entry.note .head) { flex-wrap: wrap; }
        .stream :global(.entry.note .head > :first-child) { flex: 1 1 11rem; min-width: 0; }
        .stream :global(.entry.note .head .right) { margin-left: auto; }
    }
    .stream :global(.entry.post .actions .right) { display: flex; align-items: center; gap: 0.9rem; }
    .stream :global(.entry.note .body) { font-size: 0.97em; line-height: 1.55; }
    .stream :global(.entry.note .body > p) { margin: 0.75em 0; }
    .stream :global(.entry.note .body > :first-child) { margin-top: 0; }
    .stream :global(.entry.note .body > :last-child) { margin-bottom: 0; }
    .stream :global(.entry.note .actions) { margin-top: 0.7em; }
    /* No affordance unless there is something to expand. */
    .stream :global(.entry.note:not(.is-clamped):not(.is-media-clamped):not(.is-open) .actions) { display: none; }

    /* A note clamps on PROSE, never through a photo or a video frame: a
       picture-and-a-sentence note is complete, a pasted wall of text is not. */
    .stream :global(.clip) { position: relative; overflow: hidden; display: flex; flex-direction: column; }
    .stream :global(.entry.note.is-clamped .clip) { max-height: 24rem; }
    .stream :global(.entry.note.is-clamped .clip)::after {
        content: '';
        position: absolute;
        inset: auto 0 0 0;
        height: 5rem;
        background: linear-gradient(to bottom, transparent, var(--bg));
        pointer-events: none;
    }
    .stream :global(.entry.note.is-open .clip) { max-height: none; }
    /* Media gets its own limit - several embeds is not long PROSE, so the
       prose clamp never fires and the note ends up the tallest thing here. */
    .stream :global(.entry.note.is-media-clamped .body .media-extra) { display: none; }
    /* A condensed note keeps its first piece of body media above the cut -
       Tumblr's rule, and the right one for a devlog: the eye-catching thing
       shows, the prose clamps beneath it, "Show more" opens the rest. */
    .stream :global(.entry.note.is-clamped.media-leads .body) { display: flex; flex-direction: column; }
    .stream :global(.entry.note.is-clamped.media-leads .body > .lead-media) { order: -1; margin-top: 0; margin-bottom: 0.9rem; }

    /* Caption order. The gap belongs to the photo, not the body - put it on
       the body and a note with no images carries a phantom 16px under its date. */
    /* A note has no title, so a heading inside its body is a section label,
       not a headline - and it must not outweigh a post card's title. */
    .stream :global(.entry.note .body h1), .stream :global(.entry.note .body h2), .stream :global(.entry.note .body h3), .stream :global(.entry.note .body h4) {
        font-size: 1.05em;
        font-weight: 700;
        margin: 1.1em 0 0.35em;
        line-height: 1.3;
    }
    .stream :global(.clip .body) { order: 2; }
    .stream :global(.clip .note-images) { order: 1; margin-bottom: 0.9rem; }
    .stream :global(.clip.caption-leads .body) { order: 1; margin-bottom: 0.9rem; }
    .stream :global(.clip.caption-leads .note-images) { order: 2; margin-bottom: 0; }

    /* ---------- posts ---------- */
    .stream :global(.entry.post) { margin-top: 1.6rem; margin-bottom: 1.6rem; --node-top: 1.95rem; }
    .stream :global(.entry.post .frame) {
        background: var(--code-bg);
        border: 1px solid var(--rule);
        border-radius: 12px;
        padding: 1.05rem 1.5rem 1.3rem;
        /* the connector is positioned from the frame's PADDING box, so its
           border has to come out of the offsets below */
        --card-bt: 1px;
        --card-bl: 1px;
    }
    /* layer 1: the ring's disc */
    .stream :global(.entry.post)::before {
        content: '';
        position: absolute;
        z-index: 1;
        left: var(--ring-left);
        top: calc(var(--node-top) - (var(--ring-outer) / 2));
        width: var(--ring-outer);
        height: var(--ring-outer);
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 0.25rem var(--bg);
    }
    /* layer 2: the connector, starting at the disc's centre */
    .stream :global(.entry.post .frame)::after {
        content: '';
        position: absolute;
        z-index: 2;
        left: calc(var(--node-x) - var(--card-bl));
        top: calc(var(--node-top) - 1px - var(--card-bt));
        width: calc(0px - var(--node-x) + var(--card-bl));
        height: 2px;
        background: linear-gradient(to right, var(--accent) 0, var(--accent) calc(var(--ring-outer) / 2), transparent 100%);
        pointer-events: none;
    }
    /* layer 3: the hollow, painted over the connector - so nothing has to align */
    .stream :global(.entry.post)::after {
        content: '';
        position: absolute;
        z-index: 3;
        left: calc(var(--ring-left) + var(--ring-b));
        top: calc(var(--node-top) - (var(--ring-outer) / 2) + var(--ring-b));
        width: calc(var(--ring-outer) - (2 * var(--ring-b)));
        height: calc(var(--ring-outer) - (2 * var(--ring-b)));
        border-radius: 50%;
        background: var(--bg);
        pointer-events: none;
    }
    .stream :global(.p-title) { margin: 0; line-height: 1.15; }
    .stream :global(.p-title a) {
        color: var(--fg);
        font-family: 'Marauder', serif;
        font-weight: 700;
        font-variation-settings: 'opsz' 24;
        font-size: 1.75rem;
    }
    .stream :global(.p-title a:hover) {
        color: var(--hover);
        background-color: var(--hover-bg);
        box-shadow: 0.15em 0 0 var(--hover-bg), -0.15em 0 0 var(--hover-bg);
    }
    .stream :global(.entry.post .meta) { margin: 0.55em 0 1.2em; }
    .stream :global(.excerpt > :first-child) { margin-top: 0; }
    .stream :global(.excerpt > :last-child) { margin-bottom: 0; }

    /* ---------- meta + actions ---------- */
    .stream :global(.meta) { display: flex; flex-wrap: wrap; gap: 0.45em 0.9em; align-items: baseline; font-size: 0.85em; }
    .stream :global(.date.rel) {
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.76em;
        color: var(--muted);
        letter-spacing: 0.03em;
        border-bottom: 1px dotted transparent;
        cursor: help;
    }
    .stream :global(.date.rel:hover), .stream :global(.date.rel:focus-visible) {
        color: var(--fg);
        border-bottom-color: var(--rule);
        outline: none;
    }
    .stream :global(.chips) { display: flex; flex-wrap: wrap; gap: 0.3em; }
    .stream :global(.actions) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; margin-top: 1.1em; }
    .stream :global(.entry.post .actions .right) { margin-left: auto; }
    .stream :global(.act) {
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.76rem;
        font-weight: 400;
        letter-spacing: 0.02em;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: var(--muted);
        /* Laid out inline, not as a flex box: an inline-flex takes its baseline
           from its first item, and for a control with an icon that is the <svg>
           - a replaced element whose baseline is its bottom edge, which floats
           the whole label above its neighbours. */
        display: inline-block;
        white-space: nowrap;
        text-decoration: none;
        transition: color 120ms ease, background-color 120ms ease, border-color 120ms ease;
    }
    /* The site's link hover is a highlighter swipe; on an action row it renders
       as two orange bars bracketing the label. */
    .stream :global(.act:hover), .stream :global(.act:focus-visible) {
        color: var(--accent);
        background: none;
        border-bottom-color: transparent;
        box-shadow: none;
        outline: none;
    }
    .stream :global(.act svg) { width: 1em; height: 1em; vertical-align: -0.15em; margin-right: 0.35em; }
    /* The post's one call to action, and the only contained control in the
       stream - so it reads as the thing to do. */
    .stream :global(.act.cta) {
        font-family: var(--sans);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.5em 1.1em;
    }
    .stream :global(.act.cta:hover), .stream :global(.act.cta:focus-visible) {
        background: var(--accent);
        color: var(--bg);
    }
    .stream :global(.act.cta .arrow) { display: inline-block; margin-left: 0.45em; transition: transform 140ms ease; }
    .stream :global(.act.cta:hover .arrow) { transform: translateX(0.25em); }
    .stream :global(.act.more) { display: none; }
    .stream :global(.entry.note.is-clamped .act.more),
    .stream :global(.entry.note.is-media-clamped .act.more),
    .stream :global(.entry.note.is-open .act.more) { display: inline-block; }

    /* ---------- media ---------- */
    .stream :global(.note-images) { display: grid; gap: 0.4rem; margin: 0; }
    /* The mat: a photo that does not fill the column letterboxes onto a board
       rather than leaving a ragged edge, and the frame reads as something you
       can open - which it is. */
    .stream :global(.shot) {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: var(--mat);
        border: 1px solid var(--mat-edge);
        cursor: zoom-in;
        width: 100%;
        border-radius: 10px;
        overflow: hidden;
        transition: border-color 120ms ease;
    }
    .stream :global(.shot:hover) { border-color: var(--accent); }
    .stream :global(.shot img) { display: block; object-fit: contain; }
    .stream :global(.shot.is-cropped img) { object-fit: cover; object-position: top; }
    .stream :global(.note-images.two) { grid-template-columns: 1fr 1fr; }
    .stream :global(.note-images.many) { grid-template-columns: repeat(3, 1fr); }
    .stream :global(.note-images.many img) { aspect-ratio: 1 / 1; width: 100%; height: 100%; object-fit: cover; }
    @media (max-width: 34rem) { .stream :global(.note-images.many) { grid-template-columns: repeat(2, 1fr); } }
    /* The badge only appears on an image the stream actually cropped - on a
       whole image it would be lying about what the tap does. */
    .stream :global(.expand) {
        position: absolute;
        right: 0.55rem;
        bottom: 0.55rem;
        display: none;
        align-items: center;
        gap: 0.35em;
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.68rem;
        color: #f7f2e8;
        background: rgba(20, 18, 15, 0.72);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(247, 242, 232, 0.22);
        border-radius: 999px;
        padding: 0.3em 0.7em;
    }
    .stream :global(.expand svg) { width: 0.85em; height: 0.85em; }
    .stream :global(.shot.is-cropped .expand) { display: inline-flex; }
    .stream :global(.shot.is-cropped)::after {
        content: '';
        position: absolute;
        inset: auto 0 0 0;
        height: 4.5rem;
        background: linear-gradient(to bottom, transparent, rgba(20, 18, 15, 0.55));
        pointer-events: none;
    }
    /* An embed is media too - same board, same edge, same radius. */
    .stream :global(.media-mat) {
        background: var(--mat);
        border: 1px solid var(--mat-edge);
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 1rem 0;
    }
    .stream :global(.media-mat iframe), .stream :global(.media-mat video) { display: block; border: 0; background: #000; }
    /* A <video> carries width/height attributes for its aspect ratio; without
       this it would lay out at that pixel size and the matte would crop it. */
    .stream :global(.media-mat video) { width: 100%; max-width: 100%; height: auto; }

    /* ---------- YouTube facade ---------- */
    .stream :global(.yt-facade) {
        position: relative;
        display: block;
        width: 100%;
        background: #000;
        border-radius: 10px;
        overflow: hidden;
        margin: 1rem 0;
        cursor: pointer;
    }
    .stream :global(.yt-poster) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .stream :global(.yt-play) { position: absolute; inset: 0; margin: auto; width: 68px; height: 48px; background: none; border: none; padding: 0; cursor: pointer; }
    .stream :global(.yt-play-bg) { fill: rgba(20, 18, 15, 0.72); transition: fill 120ms ease; }
    .stream :global(.yt-play-tri) { fill: #fff; }
    .stream :global(.yt-facade:hover .yt-play-bg) { fill: #e5350c; }
    .stream :global(.yt-title) {
        position: absolute;
        left: 0; right: 0; top: 0;
        padding: 0.7em 0.9em 1.6em;
        color: #fff;
        font-family: var(--sans);
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.3;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent);
        pointer-events: none;
    }

    /* ---------- year rail ---------- */
    .years { overflow-x: auto; scrollbar-width: none; margin: 0 0 1.4rem; padding-bottom: 0.3rem; }
    .years::-webkit-scrollbar { display: none; }
    .years-inner { display: flex; gap: 0.3rem; width: max-content; }
    .year {
        flex: 0 0 auto;
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.72rem;
        border: 1px solid transparent;
        color: var(--muted);
        border-radius: 999px;
        padding: 0.22em 0.6em;
        text-decoration: none;
    }
    .year:hover { color: var(--fg); background: none; box-shadow: none; border-color: var(--rule); }
    .year[aria-current='page'] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
    .year.in-view { color: var(--accent); border-color: var(--rule); }
    @media (min-width: 64rem) {
        .years { position: absolute; left: -7.5rem; top: 0; bottom: 0; width: 6.5rem; margin: 0; overflow: visible; }
        .years-inner {
            position: sticky;
            top: 1.5rem;
            flex-direction: column;
            align-items: flex-end;
            gap: 0.12rem;
            width: auto;
            max-height: calc(100vh - 3rem);
            overflow-y: auto;
            scrollbar-width: none;
        }
        .year { width: 100%; text-align: right; }
    }

    /* ---------- load more ---------- */
    /* built by the script, so it never gets Astro's scope attribute: :global */
    .stream-wrap :global(.load-more) { display: flex; align-items: center; justify-content: center; gap: 0.8rem; margin: 2.2rem 0 1rem; font-family: 'DraftingMono', ui-monospace, monospace; font-size: 0.82rem; color: var(--muted); }
    .stream-wrap :global(.load-more.top) { margin: 0 0 2rem; }
    .stream-wrap :global(.load-btn) { background: none; border: 1px solid var(--rule); border-radius: 999px; padding: 0.4em 1.1em; color: var(--fg); font: inherit; cursor: pointer; }
    .stream-wrap :global(.load-btn:hover) { border-color: var(--accent); color: var(--accent); }

    /* ---------- bursts ---------- */
    /* The fold is a deck: a bright front card with two fading cards behind it,
       offset down and right, so "several things are stacked here" reads at
       scroll speed without a word. Three explicit layers - with equal z the
       later pseudo (the outer card) would paint over the middle one. */
    .stream :global(.burst) { position: relative; padding-left: var(--item-indent); margin: 0.4rem 0 2.4rem; }
    .stream :global(.burst)::before {
        content: '';
        position: absolute;
        left: calc(var(--spine-c) - 0.45rem);
        top: 1.15rem;
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 50%;
        border: 2px solid var(--accent);
        background: var(--bg);
        box-sizing: border-box;
    }
    /* the stub from the ring into the card, same as a post's: drawn under the
       ring (which paints its own hollow over it) and under the card */
    .stream :global(.burst)::after {
        content: '';
        position: absolute;
        left: var(--spine-c);
        top: calc(1.15rem + 0.45rem - 1px);
        width: calc(var(--item-indent) - var(--spine-c) + 2px);
        height: 2px;
        background: linear-gradient(to right, var(--accent) 0, var(--accent) 45%, transparent 100%);
        pointer-events: none;
        z-index: 1;
    }
    .stream :global(.burst)::before { z-index: 2; }
    .stream :global(.burst-card) { position: relative; margin-right: 14px; }
    .stream :global(.burst-card)::before, .stream :global(.burst-card)::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 12px;
        background: var(--bg);
        pointer-events: none;
        border: 1.5px solid rgba(232, 155, 75, 0.55);
    }
    .stream :global(.burst-card)::before { z-index: 1; transform: translate(7px, 7px); }
    .stream :global(.burst-card)::after { z-index: 0; transform: translate(14px, 14px); border-color: rgba(232, 155, 75, 0.25); }
    .stream :global(.burst-card .front) {
        position: relative;
        z-index: 2;
        border-radius: 12px;
        background: var(--bg);
        border: 1.5px solid var(--accent);
        padding: 0.95rem 1.2rem 1.05rem;
    }
    .stream :global(.burst-hl) { margin: 0; font-family: 'Marauder', serif; font-weight: 700; font-size: 1.3rem; line-height: 1.15; color: var(--accent); }
    .stream :global(.burst-hl .n) { font-size: 1.15em; }
    .stream :global(.burst-meta) { margin: 0.35rem 0 0; font-family: 'DraftingMono', ui-monospace, monospace; font-size: 0.8rem; color: var(--muted); }
    .stream :global(.burst-meta a) { color: var(--fg); text-decoration: none; border-bottom: 1px dotted var(--accent); }
    .stream :global(.burst-meta a:hover) { color: var(--accent); background: none; box-shadow: none; }
    .stream :global(.burst-meta .sep) { margin: 0 0.5em; opacity: 0.5; }
    .stream :global(.burst-meta .when) { white-space: nowrap; }
    .stream :global(.burst-meta time) { cursor: default; }
    @media (max-width: 40rem) {
        /* on a phone the duration drops to its own line, without the dot */
        .stream :global(.burst-meta .when) { display: block; margin-top: 0.15rem; }
        .stream :global(.burst-meta .when .sep:first-child) { display: none; }
    }
    /* the duration is a button: click swaps it for the exact date range */
    .stream :global(.burst-span) { background: none; border: none; padding: 0; font: inherit; color: inherit; cursor: pointer; border-bottom: 1px dotted transparent; }
    .stream :global(.burst-span:hover) { color: var(--fg); border-bottom-color: var(--muted); }
    .stream :global(.burst-strip) { display: flex; gap: 0.35rem; margin: 0.75rem 0 0; }
    .stream :global(.burst-strip .thumb) {
        position: relative;
        display: block;
        width: 2.9rem;
        height: 2.9rem;
        border-radius: 6px;
        border: 1px solid var(--mat-edge);
        background: var(--mat);
        overflow: hidden;
        flex: 0 0 auto;
    }
    .stream :global(.burst-strip .thumb img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .stream :global(.burst-strip .thumb:hover) { border-color: var(--accent); background: var(--mat); box-shadow: none; }
    .stream :global(.burst-strip .thumb .play) { position: absolute; inset: 0; margin: auto; width: 1.25rem; height: 1.25rem; }
    .stream :global(.burst-strip .thumb.more) { display: flex; align-items: center; justify-content: center; font-family: 'DraftingMono', ui-monospace, monospace; font-size: 0.78rem; color: var(--accent); border-color: var(--accent); cursor: pointer; padding: 0; }
    .stream :global(.burst-actions) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.2rem; margin-top: 0.9rem; font-family: 'DraftingMono', ui-monospace, monospace; font-size: 0.85em; }
    .stream :global(.burst-open) { white-space: nowrap; background: var(--accent); border: 1.5px solid var(--accent); border-radius: 999px; padding: 0.35em 1.1em; color: var(--bg); font: inherit; font-weight: 600; cursor: pointer; }
    .stream :global(.burst-open:hover) { background: var(--fg); border-color: var(--fg); }
    .stream :global(.burst-tag) { color: var(--muted); }
    .stream :global(.burst-tag:hover) { color: var(--accent); }
    /* The revealed notes hang off a branch: a second line drops out of the
       card, runs through their dots (which sit one indent in from the main
       spine, because the burst is indented), and rejoins the spine with an
       elbow under a "Hide these" control. So you can tell, scrolling, where
       the expanded set ends and the main stream resumes. */
    .stream :global(.burst-more) { position: relative; margin-top: 1.6rem; }
    /* on the branch a dot sits on the line: the halo that lifts it off the
       faint main spine reads as a gap against an orange one */
    .stream :global(.burst-more .entry.note .meta)::before { box-shadow: none; }
    .stream :global(.burst-more .entry.burst-hidden) { display: none; }
    .stream :global(.burst-more)::before {
        content: '';
        position: absolute;
        left: var(--spine-c);
        top: -1.6rem;
        bottom: 1.6rem;
        width: 1px;
        background: rgba(232, 155, 75, 0.55);
        pointer-events: none;
    }
    .stream :global(.burst-more[hidden]) { display: none; }
    /* The branch ends by turning right into the controls, which sit centred
       in the column: the line runs to the middle and the pills (opaque) cover
       its end. The set's actions belong to the set, not to the main spine. */
    .stream :global(.burst-end) { position: relative; height: 3.2rem; display: flex; align-items: center; justify-content: center; gap: 0.7rem; padding-left: var(--item-indent); flex-wrap: wrap; }
    .stream :global(.burst-end)::before {
        content: '';
        position: absolute;
        left: var(--spine-c);
        top: 0;
        width: calc(50% - var(--spine-c));
        height: 1.6rem;
        border-left: 1px solid rgba(232, 155, 75, 0.55);
        border-bottom: 1px solid rgba(232, 155, 75, 0.55);
        border-bottom-left-radius: 10px;
        pointer-events: none;
    }
    .stream :global(.burst-page) {
        position: relative;
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.8rem;
        background: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.3em 0.9em;
        color: var(--bg);
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }
    .stream :global(.burst-page:hover) { background: var(--fg); border-color: var(--fg); }
    .stream :global(.burst-page[hidden]) { display: none; }
    .stream :global(.burst-close) {
        position: relative;
        background: var(--bg);
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.8rem;
        background: none;
        border: 1px solid rgba(232, 155, 75, 0.55);
        border-radius: 999px;
        padding: 0.3em 0.9em;
        color: var(--muted);
        cursor: pointer;
        white-space: nowrap;
    }
    .stream :global(.burst-close:hover) { color: var(--accent); border-color: var(--accent); }
    .stream :global(.burst-close .up) { display: inline-block; margin-left: 0.3em; transform: translateY(0.1em); }
    /* an expanded burst's card quietens so the run reads as one stretch */
    .stream :global(.burst.is-open .burst-card) { opacity: 0.75; }
    .stream :global(.burst.is-open .burst-card .front) { border-color: rgba(232, 155, 75, 0.5); }
    @media (max-width: 40rem) {
        .stream :global(.burst-card .front) { padding: 0.85rem 0.95rem 0.95rem; }
    }

    /* ---------- full-screen image viewer ---------- */
    #lightbox {
        position: fixed;
        inset: 0;
        z-index: 80;
        background: rgba(12, 11, 9, 0.94);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3.5rem 1rem 4.5rem;
        cursor: zoom-out;
    }
    #lightbox[hidden] { display: none; }
    #lightbox img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 4px; }
    #lightbox .lb-close, #lightbox .lb-nav {
        position: absolute;
        background: rgba(247, 242, 232, 0.1);
        border: 1px solid rgba(247, 242, 232, 0.2);
        color: #f7f2e8;
        border-radius: 999px;
        cursor: pointer;
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.8rem;
        padding: 0.45em 0.9em;
    }
    #lightbox .lb-close { top: 1rem; right: 1rem; }
    #lightbox .lb-nav { top: 50%; transform: translateY(-50%); padding: 0.6em 0.8em; }
    #lightbox .lb-prev { left: 0.8rem; }
    #lightbox .lb-next { right: 0.8rem; }
    #lightbox .lb-nav[hidden] { display: none; }
    #lightbox .lb-cap { position: absolute; left: 0; right: 0; bottom: 1.2rem; text-align: center; color: var(--muted); font-size: 0.85rem; padding: 0 1.5rem; }
</style>

<script>
    const stream = document.querySelector<HTMLElement>('.stream');
    if (stream) {
        // ---- delegated clicks: one listener per control class, so entries that
        // load-more appends later behave like the first page's
        const handlers: [string, (el: HTMLElement) => void][] = [];
        function on(selector: string, fn: (el: HTMLElement) => void) { handlers.push([selector, fn]); }
        document.addEventListener('click', (e) => {
            for (const [selector, fn] of handlers) {
                const el = (e.target as HTMLElement).closest<HTMLElement>(selector);
                if (el) { fn(el); return; }
            }
        });

        // ---- year rail scroll-spy (the rail's links work without this)
        const yearLinks = new Map<string, HTMLElement>();
        document.querySelectorAll<HTMLElement>('.year[data-year]').forEach((a) => yearLinks.set(a.dataset.year!, a));
        const spy = yearLinks.size && !document.querySelector('.year[aria-current="page"][data-year]')
            ? new IntersectionObserver(
                  (entries) => {
                      const seen = entries.filter((e) => e.isIntersecting).map((e) => (e.target as HTMLElement).dataset.year!);
                      if (!seen.length) return;
                      const cur = seen.sort().reverse()[0];
                      yearLinks.forEach((a, y) => a.classList.toggle('in-view', y === cur));
                  },
                  { rootMargin: '-25% 0px -60% 0px' },
              )
            : null;

        // ---- relative timestamps (absolute in the HTML, so no-JS still reads)
        const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
        const UNITS: [Intl.RelativeTimeFormatUnit, number][] = [
            ['year', 365 * 24 * 3600], ['month', 30 * 24 * 3600], ['week', 7 * 24 * 3600],
            ['day', 24 * 3600], ['hour', 3600], ['minute', 60],
        ];
        function relative(iso: string): string {
            const secs = (Date.parse(iso) - Date.now()) / 1000;
            const abs = Math.abs(secs);
            if (abs < 60) return 'just now';
            for (const [unit, size] of UNITS) if (abs >= size) return rtf.format(Math.round(secs / size), unit);
            return 'just now';
        }
        // Everything that has to run per entry lives in enhance(root) so a page
        // appended by load-more gets the same treatment as the first one.
        // Click handling is delegated at the document, for the same reason.
        function enhance(root: ParentNode) {
        // ---- post excerpts: 2-3 blocks, by length, never ending on a heading
        const WORD_TARGET = 110;
        root.querySelectorAll<HTMLElement>('.excerpt').forEach((ex) => {
            const blocks = Array.from(ex.children) as HTMLElement[];
            const isHeading = (el: Element) => /^H[1-6]$/.test(el.tagName);
            let words = 0;
            let keep = 0;
            for (const b of blocks) {
                keep++;
                words += (b.textContent || '').trim().split(/\s+/).filter(Boolean).length;
                if (keep >= 2 && words >= WORD_TARGET) break;
                if (keep >= 3) break;
            }
            while (keep > 1 && isHeading(blocks[keep - 1])) keep--;
            blocks.forEach((b, i) => { if (i >= keep) b.style.display = 'none'; });
        });

        // ---- give every embed the photo's frame
        root.querySelectorAll<HTMLElement>('.entry.note .body').forEach((body) => {
            body.querySelectorAll('iframe, video, .yt-facade').forEach((f) => {
                if (f.parentElement?.classList.contains('media-mat')) return;
                const mat = document.createElement('div');
                mat.className = 'media-mat';
                f.replaceWith(mat);
                mat.appendChild(f);
            });
        });
        // ---- relative timestamps (absolute in the HTML, so no-JS still reads)
        root.querySelectorAll<HTMLTimeElement>('time.rel').forEach((t) => {
            const abs = t.dataset.abs!;
            const rel = relative(t.dateTime);
            t.textContent = rel;
            // Phones have no hover, so a tap toggles to the absolute date.
            t.addEventListener('click', () => { t.textContent = t.textContent === rel ? abs : rel; });
        });
        root.querySelectorAll('.entry').forEach((el) => spy?.observe(el));
        }

        // ---- note clamping: prose only, plus a separate media limit
        const PROSE_MAX = 20 * 16;
        const hasMedia = (el: Element) =>
            !!el.querySelector('img, iframe, video, .yt-facade') || /^(IMG|IFRAME|VIDEO)$/.test(el.tagName);
        function measure() {
            document.querySelectorAll<HTMLElement>('.entry.note').forEach((n) => {
                if (n.classList.contains('is-open')) return;
                n.classList.remove('is-clamped');
                const body = n.querySelector<HTMLElement>('.body');
                if (!body) return;
                let prose = 0;
                for (const child of Array.from(body.children)) {
                    if (hasMedia(child)) continue;
                    prose += (child as HTMLElement).offsetHeight;
                }
                n.classList.toggle('is-clamped', prose > PROSE_MAX);
                const media = Array.from(body.children).filter(hasMedia) as HTMLElement[];
                // Long text with media after it: lift the first media above the
                // cut and let the clip grow to fit it plus a few lines of prose.
                const clip = n.querySelector<HTMLElement>('.clip');
                media.forEach((el, i) => el.classList.toggle('lead-media', i === 0));
                const leads = prose > PROSE_MAX && media.length > 0 && !n.querySelector('.note-images');
                n.classList.toggle('media-leads', leads);
                if (clip) clip.style.maxHeight = leads ? `${media[0].offsetHeight + 9 * 16}px` : '';
                media.forEach((el, i) => el.classList.toggle('media-extra', i > 0));
                n.classList.toggle('is-media-clamped', media.length > 1);
                const btn = n.querySelector<HTMLButtonElement>('.act.more');
                if (btn && media.length > 1) {
                    const k = media.length - 1;
                    btn.dataset.openLabel = `Show ${k} more ${k === 1 ? 'video' : 'videos'}`;
                }
            });
            document.querySelectorAll<HTMLButtonElement>('.act.more').forEach((b) => {
                const note = b.closest('.entry.note')!;
                if (!note.classList.contains('is-open')) b.textContent = b.dataset.openLabel || 'Show more';
            });
        }
        on('.act.more', (b) => {
            const note = b.closest('.entry.note')!;
            const opening = !note.classList.contains('is-open');
            note.classList.toggle('is-open', opening);
            note.classList.toggle('is-media-clamped', !opening);
            if (opening) {
                note.classList.remove('is-clamped');
                const clip = note.querySelector<HTMLElement>('.clip');
                if (clip) clip.style.maxHeight = '';
            } else measure();
            b.textContent = opening ? 'Show less' : b.dataset.openLabel || 'Show more';
            if (!opening) note.scrollIntoView({ block: 'nearest' });
        });

        // ---- image height ladder: fit, else shrink and centre, else crop
        // An image may take at most 66% of the viewport height, so a note never
        // fills the screen on its own and the page stays connected.
        const VH_CAP = 0.66;
        const MIN_WIDTH_FRACTION = 0.62;
        const PHOTO_CAP = 24 * 16;
        function sizeImage(img: HTMLImageElement) {
            if (!img.naturalWidth) return;
            const shot = img.closest<HTMLElement>('.shot');
            const grid = shot?.parentElement;
            if (!shot || !grid || !grid.classList.contains('one')) return;
            const matW = grid.clientWidth;
            if (!matW) return;
            const maxW = Math.min(matW, PHOTO_CAP);
            const cap = window.innerHeight * VH_CAP;
            const ratio = img.naturalHeight / img.naturalWidth;
            shot.classList.remove('is-cropped');
            let w = maxW;
            let h = maxW * ratio;
            if (h > cap) {
                const shrunk = cap / ratio;
                if (shrunk >= maxW * MIN_WIDTH_FRACTION) { w = shrunk; h = cap; }
                else { w = maxW * MIN_WIDTH_FRACTION; h = cap; shot.classList.add('is-cropped'); }
            }
            shot.style.height = `${Math.round(h)}px`;
            img.style.width = `${Math.round(w)}px`;
            img.style.height = `${Math.round(h)}px`;
        }
        function sizeImages() {
            document.querySelectorAll<HTMLImageElement>('.note-images img').forEach((img) => {
                if (img.complete) sizeImage(img);
                else img.addEventListener('load', () => { sizeImage(img); measure(); }, { once: true });
            });
        }
        function sizeEmbeds() {
            const cap = window.innerHeight * VH_CAP;
            document.querySelectorAll<HTMLElement>('.media-mat').forEach((mat) => {
                const f = mat.querySelector<HTMLElement>('iframe, video, .yt-facade');
                if (!f) return;
                // a self-hosted video knows its own shape; embeds are 16:9
                const ar = f instanceof HTMLVideoElement && f.width && f.height ? f.width / f.height : 16 / 9;
                const w = mat.clientWidth;
                if (!w) return;
                // A video needs width to be watchable, so it fills the board
                // rather than obeying the photo cap - but it answers to the
                // same height ceiling.
                const h = Math.min(w / ar, cap);
                f.style.width = `${Math.round(h * ar)}px`;
                f.style.height = `${Math.round(h)}px`;
                f.style.maxWidth = '100%';
            });
        }
        enhance(document);
        sizeImages();
        sizeEmbeds();
        measure();
        window.addEventListener('load', () => { sizeImages(); sizeEmbeds(); measure(); });
        let rz: number;
        window.addEventListener('resize', () => {
            clearTimeout(rz);
            rz = window.setTimeout(() => { sizeImages(); sizeEmbeds(); measure(); }, 150);
        });

        // ---- facade -> real player, only on demand
        document.addEventListener('click', (e) => {
            const facade = (e.target as HTMLElement).closest<HTMLElement>('.yt-facade');
            if (!facade) return;
            const id = facade.dataset.yt;
            if (!id) return;
            const f = document.createElement('iframe');
            f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
            f.title = facade.dataset.ytTitle || 'Video';
            f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
            f.allowFullscreen = true;
            f.style.cssText = 'width:100%;aspect-ratio:16/9;border:0;display:block';
            facade.replaceWith(f);
        });

        // ---- share: the site's one link dialog (LinkModal, via the Footer)
        on('.act.share', (b) => {
            const entry = b.closest<HTMLElement>('.entry')!;
            const url = new URL(entry.dataset.href!, location.origin).href;
            const kind = entry.dataset.kind === 'post' ? 'post' : 'note';
            const title = entry.querySelector('.title-link')?.textContent?.trim();
            (window as any).openLinkPreview?.(url, title ? `Share "${title}"` : `Share this ${kind}`, `The link to this ${kind}. Copy it, or hand it to another app.`);
        });

        // ---- full-screen viewer
        const lb = document.getElementById('lightbox')!;
        const lbImg = document.getElementById('lb-img') as HTMLImageElement;
        const lbCap = document.getElementById('lb-cap')!;
        const prevBtn = lb.querySelector<HTMLButtonElement>('.lb-prev')!;
        const nextBtn = lb.querySelector<HTMLButtonElement>('.lb-next')!;
        let group: HTMLImageElement[] = [];
        let idx = 0;
        function paint() {
            const img = group[idx];
            lbImg.src = img.currentSrc || img.src;
            lbImg.alt = img.alt;
            lbCap.textContent = (img.alt || '') + (group.length > 1 ? `  (${idx + 1}/${group.length})` : '');
            prevBtn.hidden = group.length < 2;
            nextBtn.hidden = group.length < 2;
        }
        function closeLb() { lb.hidden = true; document.body.style.overflow = ''; }
        on('.shot', (b) => {
            const img = b.querySelector('img')!;
            group = Array.from(b.closest('.note-images')!.querySelectorAll<HTMLImageElement>('img'));
            idx = group.indexOf(img);
            paint();
            lb.hidden = false;
            document.body.style.overflow = 'hidden';
        });
        lb.addEventListener('click', (e) => { if (e.target === lb || e.target === lbImg) closeLb(); });
        lb.querySelector('.lb-close')!.addEventListener('click', closeLb);
        prevBtn.addEventListener('click', (e) => { e.stopPropagation(); idx = (idx - 1 + group.length) % group.length; paint(); });
        nextBtn.addEventListener('click', (e) => { e.stopPropagation(); idx = (idx + 1) % group.length; paint(); });
        document.addEventListener('keydown', (e) => {
            if (lb.hidden) return;
            if (e.key === 'Escape') closeLb();
            if (e.key === 'ArrowLeft') prevBtn.click();
            if (e.key === 'ArrowRight') nextBtn.click();
        });

        // ---- bursts: fold and unfold in place
        // Reveal the next page of a burst's entries (or everything up to `upTo`,
        // for a landing on an entry deep inside one) and repaint the footer.
        // size + clamp whatever just became visible (hoisted: the restore path
        // can open a burst before the load-more section below has run)
        function settle() { sizeImages(); sizeEmbeds(); measure(); }
        function revealIn(burst: HTMLElement, upTo?: HTMLElement) {
            const more = burst.querySelector<HTMLElement>('.burst-more')!;
            const size = Number(more.dataset.pageSize || 5);
            const entries = Array.from(more.querySelectorAll<HTMLElement>(':scope > .entry'));
            let shown = entries.filter((e) => !e.classList.contains('burst-hidden')).length;
            const target = upTo ? Math.max(shown + size, entries.indexOf(upTo) + 1) : shown + size;
            entries.forEach((e, i) => e.classList.toggle('burst-hidden', i >= target));
            shown = Math.min(target, entries.length);
            const pageBtn = more.querySelector<HTMLButtonElement>('.burst-page')!;
            const left = entries.length - shown;
            pageBtn.hidden = left <= 0;
            pageBtn.textContent = `Show ${Math.min(size, left)} more #${burst.dataset.tag} notes · ${left} left`;
            settle();
        }
        function openBurst(burst: HTMLElement, upTo?: HTMLElement) {
            burst.classList.add('is-open');
            const more = burst.querySelector<HTMLElement>('.burst-more')!;
            more.hidden = false;
            // start from the first page every time it opens
            more.querySelectorAll<HTMLElement>(':scope > .entry').forEach((e) => e.classList.add('burst-hidden'));
            // (revealIn measures the newly visible entries: they were display:none
            // when the page sized itself, so every read was 0.)
            revealIn(burst, upTo);
            const btn = burst.querySelector<HTMLButtonElement>('.burst-open')!;
            btn.textContent = 'Hide the notes';
            btn.setAttribute('aria-expanded', 'true');
        }
        function closeBurst(burst: HTMLElement) {
            burst.classList.remove('is-open');
            burst.querySelector<HTMLElement>('.burst-more')!.hidden = true;
            const btn = burst.querySelector<HTMLButtonElement>('.burst-open')!;
            btn.textContent = 'View the notes';
            btn.setAttribute('aria-expanded', 'false');
            // don't leave the reader stranded below the fold they just closed
            burst.scrollIntoView({ block: 'nearest' });
        }
        const burstOf = (el: HTMLElement) => el.closest<HTMLElement>('.burst')!;
        on('.burst-open', (b) => { const burst = burstOf(b); if (burst.classList.contains('is-open')) closeBurst(burst); else openBurst(burst); });
        on('.burst-close', (b) => closeBurst(burstOf(b)));
        on('.burst-page', (b) => revealIn(burstOf(b)));
        on('.burst-open-alt', (b) => {
            const burst = burstOf(b);
            openBurst(burst);
            burst.querySelector<HTMLElement>('.burst-more')!.scrollIntoView({ block: 'start', behavior: 'smooth' });
        });
        on('.burst-span', (b) => {
            const showingRange = b.textContent === b.dataset.range;
            b.textContent = showingRange ? b.dataset.span! : b.dataset.range!;
        });

        // ---- return to where you were -----------------------------------
        // The browser's own scroll restoration cannot be trusted here:
        // `content-visibility: auto` means most entries have an ESTIMATED height
        // until they are near the viewport, so on a back-navigation the document
        // is briefly much shorter than it was and the restored offset gets
        // clamped. Measured: leave from y=2400, come back at y=520.
        //
        // So the stream remembers which ENTRY you left from, not a pixel offset,
        // and restores relative to that element once layout has settled.
        const RETURN_KEY = 'stream-return';
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

        stream.addEventListener('click', (e) => {
            const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
            const entry = (e.target as HTMLElement).closest<HTMLElement>('.entry');
            if (!a || !entry || a.hasAttribute('data-back')) return;
            try {
                const p = location.pathname;
                const from = p.startsWith('/posts') ? 'everything' : p.startsWith('/tags/') ? '#' + decodeURIComponent(p.split('/')[2]) : p === '/' ? 'home' : 'back';
                // An entry that load-more appended belongs to a later page;
                // remember that page, so the return renders the one it is on.
                const chunk = entry.closest<HTMLElement>('[data-page-url]');
                sessionStorage.setItem(RETURN_KEY, JSON.stringify({
                    path: chunk ? chunk.dataset.pageUrl : location.pathname + location.search,
                    from,
                    ts: Date.now(),
                    id: entry.id,
                    // where the entry sat in the viewport when you left it
                    viewportTop: Math.round(entry.getBoundingClientRect().top),
                }));
            } catch {}
        });

        // Scroll so `el` sits `viewportTop` px down the viewport, and keep it
        // there until layout stops moving (see the comments inside).
        function holdAt(el: HTMLElement, viewportTop: number) {
            const target = () => {
                const docTop = el.getBoundingClientRect().top + window.scrollY;
                return Math.max(0, Math.round(docTop - viewportTop));
            };
            // Hold the position until it stops moving. Media above the target
            // (a poster frame, an image) resolves its height after the first
            // paint and shifts everything below it, and the browser's scroll
            // anchoring then nudges us again - so a fixed number of corrections
            // lands short. Re-assert until two readings agree, then stop.
            // ...but never fight the reader. Any deliberate scroll input ends
            // the hold immediately, otherwise a 1.5s correction loop would drag
            // them back while they are already moving.
            let aborted = false;
            const stop = () => { aborted = true; };
            const opts = { passive: true, once: true } as AddEventListenerOptions;
            window.addEventListener('wheel', stop, opts);
            window.addEventListener('touchstart', stop, opts);
            window.addEventListener('keydown', stop, opts);

            let settled = 0;
            let last = -1;
            const hold = () => {
                if (aborted) return;
                const t = target();
                if (Math.abs(t - window.scrollY) > 1) window.scrollTo(0, t);
                settled = t === last ? settled + 1 : 0;
                last = t;
                if (settled < 3 && performance.now() - startedAt < 1500) requestAnimationFrame(hold);
            };
            const startedAt = performance.now();
            stream!.classList.add('is-restoring');
            hold();
            setTimeout(() => stream!.classList.remove('is-restoring'), 1600);
            el.classList.add('landed');
            setTimeout(() => el.classList.remove('landed'), 1800);
        }

        function restoreReturn() {
            let saved: { path: string; id: string; viewportTop: number } | null = null;
            try {
                saved = JSON.parse(sessionStorage.getItem(RETURN_KEY) || 'null');
            } catch {}
            if (!saved || saved.path !== location.pathname + location.search) {
                // Nothing remembered for this page, but a #e-<id> hash (the
                // permalink's fallback back-link) still names an entry: unfold
                // it if a burst hides it, centre it, and mark it.
                const hashed = /^#e-/.test(location.hash) ? document.getElementById(location.hash.slice(1)) : null;
                if (hashed) {
                    // The browser keeps retrying its own scroll-to-fragment until
                    // the target has a box - which it gets the moment the burst
                    // opens - and that jump lands the entry at y=0 over our hold.
                    // Drop the fragment so there is nothing for it to chase.
                    history.replaceState(history.state, '', location.pathname + location.search);
                    const fold = hashed.closest<HTMLElement>('.burst');
                    if (fold) openBurst(fold, hashed);
                    holdAt(hashed, Math.round(window.innerHeight * 0.22));
                }
                return;
            }
            sessionStorage.removeItem(RETURN_KEY);
            const el = document.getElementById(saved.id);
            if (!el) return;
            // Left from inside a burst? It folded again on reload - unfold it
            // first, or the target has no box to scroll to.
            const fold = el.closest<HTMLElement>('.burst');
            if (fold) openBurst(fold, el);
            holdAt(el, saved.viewportTop);
        }
        restoreReturn();
        // A browser-button back can serve this page from the bfcache, where the
        // module script does not re-run - pageshow is the only hook that fires.
        window.addEventListener('pageshow', (e) => { if (e.persisted) restoreReturn(); });
        // An in-page jump to #e-<id> (same-document navigation, so no reload)
        // takes the same landing path.
        window.addEventListener('hashchange', restoreReturn);

        // ---- load more: the static pages become one growing stream ----------
        // Older pages append as the reader nears the bottom; from page 2 on, a
        // "newer" control prepends (manually - prepending on scroll would fight
        // the reader). Each appended page is wrapped in a chunk that records
        // its URL, which is what the return-to-entry memory keys on.
        const pagers = Array.from(document.querySelectorAll<HTMLElement>('.pager'));
        const bottomPager = pagers[pagers.length - 1];
        const topPager = pagers.length > 1 ? pagers[0] : null;
        let olderUrl: string | null = bottomPager?.querySelector<HTMLAnchorElement>('a[rel=next]')?.getAttribute('href') ?? null;
        let newerUrl: string | null = bottomPager?.querySelector<HTMLAnchorElement>('a[rel=prev]')?.getAttribute('href') ?? null;
        const lastPage = Number(bottomPager?.dataset.last || 1);
        const pageNo = (url: string) => Number(url.match(/\/page\/(\d+)\//)?.[1] ?? 1);
        async function fetchPage(url: string) {
            const res = await fetch(url, { headers: { Accept: 'text/html' } });
            if (!res.ok) throw new Error(String(res.status));
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            const chunk = document.createElement('div');
            chunk.className = 'page-chunk';
            chunk.dataset.pageUrl = new URL(url, location.origin).pathname;
            chunk.innerHTML = doc.querySelector('.stream')?.innerHTML ?? '';
            const pager = doc.querySelector('.pager');
            return {
                chunk,
                next: pager?.querySelector('a[rel=next]')?.getAttribute('href') ?? null,
                prev: pager?.querySelector('a[rel=prev]')?.getAttribute('href') ?? null,
            };
        }
        if (bottomPager) {
            const more = document.createElement('div');
            more.className = 'load-more';
            more.innerHTML = '<button type="button" class="load-btn"></button><span class="load-status"></span>';
            bottomPager.replaceWith(more);
            const btn = more.querySelector<HTMLButtonElement>('.load-btn')!;
            const status = more.querySelector<HTMLElement>('.load-status')!;
            let busy = false;
            const paint = () => {
                if (olderUrl) { btn.hidden = false; btn.textContent = `Load older · page ${pageNo(olderUrl)} of ${lastPage}`; status.textContent = ''; }
                else { btn.hidden = true; status.textContent = 'That is everything.'; }
            };
            async function loadOlder() {
                if (busy || !olderUrl) return;
                busy = true;
                btn.textContent = 'Loading…';
                try {
                    const { chunk, next } = await fetchPage(olderUrl);
                    stream!.appendChild(chunk);
                    enhance(chunk);
                    settle();
                    olderUrl = next;
                } catch { status.textContent = 'Could not load more - '; btn.textContent = 'try again'; busy = false; return; }
                busy = false;
                paint();
            }
            btn.addEventListener('click', loadOlder);
            paint();
            // auto-load when the control comes within a screen of the viewport
            new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) loadOlder(); }, { rootMargin: '100% 0px' }).observe(more);
        }
        if (topPager) {
            const newer = document.createElement('div');
            newer.className = 'load-more top';
            newer.innerHTML = '<button type="button" class="load-btn"></button>';
            topPager.replaceWith(newer);
            const btn = newer.querySelector<HTMLButtonElement>('.load-btn')!;
            const paint = () => {
                if (newerUrl) { btn.hidden = false; btn.textContent = `Load newer · page ${pageNo(newerUrl)} of ${lastPage}`; }
                else newer.remove();
            };
            btn.addEventListener('click', async () => {
                if (!newerUrl) return;
                btn.textContent = 'Loading…';
                try {
                    const { chunk, prev } = await fetchPage(newerUrl);
                    // keep what the reader is looking at where it is
                    const before = document.documentElement.scrollHeight;
                    stream!.prepend(chunk);
                    enhance(chunk);
                    settle();
                    window.scrollBy(0, document.documentElement.scrollHeight - before);
                    newerUrl = prev;
                } catch { btn.textContent = 'Could not load - try again'; return; }
                paint();
            });
            paint();
        }
    }
</script>
