---
// Site-wide link modal - the one way the site hands a reader a URL. Any
// [data-link-preview] anchor (the RSS feed links) opens it instead of
// navigating; the stream's Share action opens it for an entry's permalink
// (window.openLinkPreview). It shows the address in a selectable field, a Copy
// button, the OS share sheet where the browser has one, Open, and Close - so
// "share" and "copy the link" are one dialog, not two buttons that do the same
// thing with a label that flashes. Opening it closes any open subscribe modal
// so two overlays never stack. Included once, via the Footer.
---

<style is:global>
    .linkmodal-back {
        position: fixed;
        inset: 0;
        z-index: 1200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5em;
        background: rgba(0, 0, 0, 0.55);
    }
    .linkmodal {
        background: var(--bg);
        color: var(--fg);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 1.4em 1.5em;
        max-width: 28em;
        width: 100%;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    }
    .linkmodal h3 {
        margin: 0 0 0.6em;
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.95rem;
        letter-spacing: 0.03em;
    }
    .linkmodal-note {
        color: var(--muted);
        font-size: 0.9rem;
        margin: 0.6em 0;
        line-height: 1.5;
    }
    .linkmodal-url {
        width: 100%;
        box-sizing: border-box;
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.85rem;
        color: var(--fg);
        background: var(--code-bg);
        border: 1px solid var(--rule);
        border-radius: 6px;
        padding: 0.6em 0.7em;
        margin: 0.4em 0 1em;
    }
    .linkmodal-row {
        display: flex;
        gap: 0.6em;
        justify-content: flex-end;
    }
    .linkmodal-btn {
        font-family: 'DraftingMono', ui-monospace, monospace;
        font-size: 0.82rem;
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--rule);
        border-radius: 6px;
        padding: 0.45em 0.9em;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }
    .linkmodal-btn:hover {
        background: var(--hover-bg);
        color: var(--hover);
        border-color: var(--hover-bg);
    }
    .linkmodal-btn-ghost {
        color: var(--muted);
    }
</style>

<script>
    function openLinkPreview(url: string, label: string, hint?: string) {
        // Never stack overlays: drop any open subscribe modal first.
        document
            .querySelectorAll<HTMLElement>('[data-subscribe-modal]')
            .forEach((m) => (m.hidden = true));

        const back = document.createElement('div');
        back.className = 'linkmodal-back';
        const esc = (e: KeyboardEvent) => {
            if (e.key === 'Escape') close();
        };
        const close = () => {
            back.remove();
            document.removeEventListener('keydown', esc);
        };
        document.addEventListener('keydown', esc);
        back.addEventListener('click', (e) => {
            if (e.target === back) close();
        });

        const box = document.createElement('div');
        box.className = 'linkmodal';

        const h = document.createElement('h3');
        h.textContent = label;

        const note = document.createElement('p');
        note.className = 'linkmodal-note';
        note.textContent = hint ?? 'Paste this address into your RSS reader - copy it by hand, or use the button.';

        const input = document.createElement('input');
        input.className = 'linkmodal-url';
        input.type = 'text';
        input.readOnly = true;
        input.value = url;
        input.setAttribute('aria-label', `${label} address`);
        input.addEventListener('focus', () => input.select());

        const copy = document.createElement('button');
        copy.className = 'linkmodal-btn';
        copy.type = 'button';
        copy.textContent = 'Copy';
        copy.addEventListener('click', async () => {
            input.select();
            try {
                await navigator.clipboard.writeText(url);
                copy.textContent = 'Copied';
            } catch {
                copy.textContent = 'Select & copy above';
            }
        });

        const open = document.createElement('a');
        open.className = 'linkmodal-btn linkmodal-btn-ghost';
        open.textContent = 'Open';
        open.href = url;
        open.target = '_blank';
        open.rel = 'noopener';

        const done = document.createElement('button');
        done.className = 'linkmodal-btn linkmodal-btn-ghost';
        done.type = 'button';
        done.textContent = 'Close';
        done.addEventListener('click', close);

        const row = document.createElement('div');
        row.className = 'linkmodal-row';
        row.append(copy);
        if (navigator.share) {
            // phones: the OS sheet is the real share; the URL field is the fallback
            const sheet = document.createElement('button');
            sheet.className = 'linkmodal-btn';
            sheet.type = 'button';
            sheet.textContent = 'Share…';
            sheet.addEventListener('click', async () => {
                try { await navigator.share({ title: label, url }); close(); } catch {}
            });
            row.append(sheet);
        }
        row.append(open, done);

        box.append(h, note, input, row);
        back.append(box);
        document.body.append(back);
        setTimeout(() => input.select(), 0);
    }

    // Delegated, so links the stream appends later (load-more) work too.
    document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-link-preview]');
        if (!a) return;
        e.preventDefault();
        const url = new URL(a.getAttribute('href') || '', location.origin).toString();
        openLinkPreview(url, a.dataset.linkPreviewLabel || 'Link');
    });
    (window as any).openLinkPreview = openLinkPreview;
</script>
