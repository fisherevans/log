---
// /posts - the site's only listing. Posts and notes interleaved; there is no
// separate /notes index (notes keep their permalinks, where the comments are).
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SearchBox from '../../components/SearchBox.astro';
import Stream from '../../components/Stream.astro';
import { PAGE_SIZE, buildStream, groupBursts, pageOf, yearsOf } from '../../lib/stream';
import { dateMap, searchIndex } from '../../lib/search';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const all = await buildStream();
const blocks = groupBursts(all);
const last = Math.max(1, Math.ceil(blocks.length / PAGE_SIZE));
const page = pageOf(blocks, 1);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`Posts · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <style>
            h1 { margin: 0 0 1.2rem; }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <h1>Posts</h1>
            <SearchBox index={searchIndex(all)} dateMap={dateMap(all)} />
            <div id="listing">
                <Stream
                    blocks={page.blocks}
                    offset={page.offset}
                    years={yearsOf(all)}
                    page={{ current: 1, last, hrefFor: (n: number) => (n === 1 ? '/posts/' : `/posts/page/${n}/`) }}
                    total={all.length}
                    pageSize={PAGE_SIZE}
                />
            </div>
        </main>
        <Footer />
    </body>
</html>
