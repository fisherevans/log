---
// SPECIMEN - a design sandbox for the notes rollout. Not linked from the site.
// Delete this directory (and src/lib/specimen.ts) once a direction is picked.
//
// Renders the REAL corpus as the proposed mixed stream: 11 long entries stay
// posts, 16 short ones render as notes with their titles dropped, plus the 5
// existing notes. Every treatment is a data-attribute on #stream so variants
// can be compared without a rebuild.
import { getCollection, render } from 'astro:content';
import { postHref } from '../../lib/posts';
import { noteHref } from '../../lib/notes';
import { JUDGMENT_CALLS, RECLASS_TO_NOTE } from '../../lib/specimen';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const notes = await getCollection('notes', ({ data }) => !data.draft);

type Item = {
    kind: 'post' | 'note';
    slug: string;
    date: Date;
    title?: string;
    tags: string[];
    href: string;
    images: { src: string; alt?: string }[];
    migrated: boolean;
    judgment: boolean;
    demo?: boolean;
    html?: string;
    // A short note's prose reads as a caption, and captions lead. A long one
    // would push its picture off the fold, so it follows instead.
    captionLeads: boolean;
    Content?: any;
};

const CAPTION_WORDS = 55;
const wordCount = (body: string) => body.trim().split(/\s+/).filter(Boolean).length;

const items: Item[] = [];
for (const p of posts) {
    const { Content } = await render(p);
    const asNote = RECLASS_TO_NOTE.has(p.id);
    items.push({
        kind: asNote ? 'note' : 'post',
        slug: p.id,
        date: p.data.date,
        title: asNote ? undefined : p.data.title,
        tags: p.data.tags,
        href: asNote ? `/notes/${p.id}/` : postHref(p),
        images: [],
        migrated: asNote,
        judgment: JUDGMENT_CALLS.has(p.id),
        captionLeads: false,
        Content,
    });
}
for (const n of notes) {
    const { Content } = await render(n);
    items.push({
        kind: 'note',
        slug: n.id,
        date: n.data.date,
        tags: n.data.tags,
        href: noteHref(n),
        images: n.data.images,
        migrated: false,
        judgment: false,
        captionLeads: wordCount(n.body ?? '') <= CAPTION_WORDS,
        Content,
    });
}

// Every real note image is 1:1, so nothing in the corpus exercises the tall-image
// crop. This one is three of Fisher's own dye shots stacked into a 1:3 frame.
items.push({
    kind: 'note',
    slug: 'tall-demo',
    date: new Date('2023-05-19T00:00:00Z'),
    tags: ['disc-dyes'],
    href: '/notes/2023/05/19/tall-demo/',
    images: [{ src: '/seed/tall-demo.jpg', alt: 'Three dyed discs, stacked' }],
    migrated: false,
    judgment: false,
    demo: true,
    captionLeads: true,
    html: '<p>Three at once - a 1:3 frame. Too tall to shrink, so the stream crops it.</p>',
});

// The commonest real case and also missing from the corpus: an ordinary 3:4
// phone photo, which the ladder shrinks and centres rather than crops.
items.push({
    kind: 'note',
    slug: 'portrait-demo',
    date: new Date('2023-05-20T00:00:00Z'),
    tags: ['disc-dyes'],
    href: '/notes/2023/05/20/portrait-demo/',
    images: [{ src: '/seed/portrait-demo.jpg', alt: 'A dyed disc, portrait crop' }],
    migrated: false,
    judgment: false,
    demo: true,
    captionLeads: true,
    html: '<p>A 3:4 phone photo - shrunk to the height cap and centred, still whole.</p>',
});
items.sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Responsive candidates for the seed images (real media would come off R2 the
// same way). Serving a 1080px photo into a 384px slot was most of the 27MB the
// page still weighed once the embeds were gone.
const srcSet = (src: string) => {
    const m = src.match(/^(.*)\.(jpg|jpeg|png|webp)$/i);
    if (!m) return undefined;
    // Only advertise candidates that exist - a srcset entry that 404s is not
    // a graceful fallback, the browser just fails to paint it.
    const cands: string[] = [];
    for (const w of [400, 800, 1080, 1600]) {
        const path = `${m[1]}-${w}.${m[2]}`;
        if (existsSync(join('public', path))) cands.push(`${path} ${w}w`);
    }
    return cands.length > 1 ? cands.join(', ') : undefined;
};

const absolute = (d: Date) =>
    d.toLocaleDateString('en-us', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

const postCount = items.filter((i) => i.kind === 'post').length;
const noteCount = items.filter((i) => i.kind === 'note').length;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="Specimen · notes rollout" description="Design sandbox for the notes rollout." />
        <style>
            /* ---------- specimen chrome (not part of the proposal) ---------- */
            .lab {
                position: sticky;
                top: 0;
                z-index: 40;
                background: var(--bg);
                border-bottom: 1px solid var(--rule);
                padding: 0.7rem var(--content-pad-x) 0.8rem;
                margin: 0 calc(-1 * var(--content-pad-x));
            }
            .lab h1 {
                font-size: 0.72rem;
                font-family: var(--sans);
                font-weight: 700;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--muted);
                margin: 0 0 0.55rem;
            }
            .knobs { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; align-items: center; }
            .knob { display: flex; align-items: center; gap: 0.35rem; }
            .knob > span {
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.64rem;
                color: var(--muted);
                letter-spacing: 0.04em;
            }
            .knob button {
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.7rem;
                background: none;
                border: 1px solid var(--rule);
                color: var(--muted);
                border-radius: 999px;
                padding: 0.22em 0.7em;
                cursor: pointer;
            }
            .knob button[aria-pressed='true'] {
                border-color: var(--accent);
                color: var(--bg);
                background: var(--accent);
            }
            @media (max-width: 40rem) {
                .lab { padding: 0.5rem var(--content-pad-x) 0.55rem; }
                .lab h1 { font-size: 0.58rem; margin-bottom: 0.4rem; }
                .knobs {
                    flex-wrap: nowrap;
                    overflow-x: auto;
                    gap: 0.75rem;
                    scrollbar-width: none;
                    -webkit-overflow-scrolling: touch;
                }
                .knobs::-webkit-scrollbar { display: none; }
                .knob { flex: 0 0 auto; }
                .knob > span { font-size: 0.56rem; }
                .knob button { font-size: 0.6rem; padding: 0.18em 0.55em; }
            }

            details.brief {
                margin: 1.4rem 0 1.8rem;
            }
            details.brief > summary {
                cursor: pointer;
                font-family: var(--sans);
                font-size: 0.74rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--muted);
            }
            .note-to-self {
                font-size: 0.9rem;
                color: var(--muted);
                max-width: 40em;
                margin: 0.9rem 0 0;
                line-height: 1.6;
            }

            /* ---------- the reader-facing filter (part of the proposal) ---------- */
            .filter {
                display: flex;
                gap: 0.4rem;
                margin: 0 0 2rem;
                padding-bottom: 1rem;
                border-bottom: 1px solid var(--rule);
            }
            .filter button {
                font-family: var(--sans);
                font-size: 0.8rem;
                font-weight: 600;
                background: none;
                border: 1px solid var(--rule);
                border-radius: 999px;
                color: var(--muted);
                padding: 0.4em 0.95em;
                cursor: pointer;
                display: inline-flex;
                gap: 0.45em;
                align-items: baseline;
            }
            .filter button:hover { color: var(--fg); border-color: var(--muted); }
            .filter button[aria-pressed='true'] { color: var(--fg); border-color: var(--accent); }
            .filter .count {
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.72em;
                opacity: 0.7;
            }

            /* ---------- shared stream bits ---------- */
            #stream { display: flex; flex-direction: column; }
            .item { scroll-margin-top: 6rem; }
            .meta {
                display: flex;
                flex-wrap: wrap;
                gap: 0.45em 0.9em;
                align-items: baseline;
                font-size: 0.85em;
            }
            .meta .date {
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.76em;
                color: var(--muted);
                letter-spacing: 0.03em;
                border-bottom: none;
            }
            .meta .date.rel {
                cursor: help;
                border-bottom: 1px dotted transparent;
            }
            .meta .date.rel:hover,
            .meta .date.rel:focus-visible {
                color: var(--fg);
                border-bottom-color: var(--rule);
                outline: none;
            }
            .chips { display: flex; flex-wrap: wrap; gap: 0.3em; }
            .actions {
                display: flex;
                align-items: center;
                gap: 0.8rem;
                margin-top: 1.1em;
            }
            .act {
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.76rem;
                font-weight: 400;
                letter-spacing: 0.02em;
                background: none;
                border: none;
                padding: 0;
                cursor: pointer;
                color: var(--muted);
                /* Laid out inline, not as a flex box: an inline-flex takes its
                   baseline from its first flex item, and for the share control
                   that item is the <svg> - a replaced element whose baseline is
                   its bottom edge, which floated the whole label above its
                   neighbours. Inline, every baseline comes from text. */
                display: inline-block;
                white-space: nowrap;
                text-decoration: none;
            }
            .act:hover,
            .act:focus-visible {
                color: var(--accent);
                background: none;
                border-bottom-color: transparent;
                box-shadow: none;
            }
            .act svg {
                width: 0.95em;
                height: 0.95em;
                vertical-align: -0.13em;
                margin-left: 0.4em;
            }
            /* The post's one call to action, and the only contained control in
               the stream: an accent pill that fills on hover. Everything else
               stays a plain mark, so this reads as the thing to do. */
            .act.cta {
                font-family: var(--sans);
                font-size: 0.76rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                color: var(--accent);
                border: 1px solid var(--accent);
                border-radius: 999px;
                padding: 0.5em 1.1em;
            }
            .act.cta:hover,
            .act.cta:focus-visible {
                background: var(--accent);
                color: var(--bg);
                border-color: var(--accent);
            }
            .act.cta .arrow { display: inline-block; margin-left: 0.45em; transition: transform 140ms ease; }
            .act.cta:hover .arrow, .act.cta:focus-visible .arrow { transform: translateX(0.25em); }

            .act .lead { display: inline-block; margin-right: 0.3em; line-height: 1; transition: transform 140ms ease; }
            .act:hover .lead, .act:focus-visible .lead { transform: translateX(-0.2em); }

            /* Left group and right group, rather than one run of controls.
               Show more belongs to the content it expands; the permalink and
               share belong to the entry. */
            .actions { justify-content: space-between; }
            .actions .right { display: flex; align-items: center; gap: 0.9rem; }
            .act.primary:hover,
            .act.primary:focus-visible {
                background: none;
                border-color: var(--accent);
                color: var(--accent);
                box-shadow: none;
            }
            .act.copied { color: var(--accent); }

            /* ================= POST treatments ================= */
            .post .frame { padding: 0; }
            .p-title { margin: 0; line-height: 1.15; }
            .p-title a {
                color: var(--fg);
                font-family: 'Marauder', serif;
                font-weight: 700;
                font-variation-settings: 'opsz' 24;
                font-size: 1.75rem;
            }
            .p-title a:hover {
                color: var(--hover);
                background-color: var(--hover-bg);
                box-shadow: 0.15em 0 0 var(--hover-bg), -0.15em 0 0 var(--hover-bg);
            }
            .post .meta { margin: 0.55em 0 1.2em; }
            .post .excerpt > :global(:first-child) { margin-top: 0; }
            .post .excerpt > :global(:last-child) { margin-bottom: 0; }

            /* P1 - framed card. Weight from presence: it occupies a box. */
            #stream[data-post='card'] .post { margin: 1.6rem 0; }
            #stream[data-post='card'] .post .frame {
                background: var(--code-bg);
                border: 1px solid var(--rule);
                border-radius: 12px;
                padding: 1.05rem 1.5rem 1.3rem;
            }
            /* P2 - heavy row. Weight from typography + air, no container. */
            #stream[data-post='row'] .post { margin: 2.6rem 0; }
            #stream[data-post='row'] .post .frame {
                border-top: 2px solid var(--fg);
                padding-top: 1.3rem;
            }
            #stream[data-post='row'] .p-title a { font-size: 2rem; font-variation-settings: 'opsz' 28; }

            /* ================= NOTE treatments ================= */
            .note { margin: 1.5rem 0; }
            .note .frame { position: relative; }
            /* The permalink and share belong to the entry, so they sit on the
               entry's own line - the date's - rather than trailing the content. */
            .note .head {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                gap: 1rem;
                margin: 0 0 0.3em;
            }
            .note .head .right { display: flex; align-items: baseline; gap: 0.9rem; flex: 0 0 auto; }
            .note .meta { margin: 0; }
            .note .actions { margin-top: 0.7em; }
            .note:not(.is-clamped):not(.is-media-clamped):not(.is-open) .actions { display: none; }
            .note .body { font-size: 0.97em; line-height: 1.55; }
            .note .body > :global(p) { margin: 0.75em 0; }
            .note .meta { margin-bottom: 0.15em; }
            .note .actions { margin-top: 0.8em; }
            .note .body > :global(:first-child) { margin-top: 0; }
            .note .body > :global(:last-child) { margin-bottom: 0; }
            /* A note is complete in the stream, but a pasted wall of text or a
               stack of embeds isn't - so clamp and expand inline. */
            .note .clip { position: relative; overflow: hidden; }
            .note.is-clamped .clip { max-height: 24rem; }
            .note.is-clamped .clip::after {
                content: '';
                position: absolute;
                inset: auto 0 0 0;
                height: 5rem;
                background: linear-gradient(to bottom, transparent, var(--bg));
                pointer-events: none;
            }
            .note.is-open .clip { max-height: none; }
            /* A note with several embeds (the OpenGL coursework note is five
               videos) is not long in PROSE, so the prose clamp never fires and
               the note ends up taller than anything else on the page. Media gets
               its own limit: the stream shows the first one, the rest expand. */
            .note.is-media-clamped .body :global(.media-extra) { display: none; }
            .note .more { display: none; }
            .note:not(.is-clamped):not(.is-media-clamped):not(.is-open) .actions { justify-content: flex-end; }
            .note.is-clamped .more,
            .note.is-media-clamped .more,
            .note.is-open .more { display: inline-flex; }

            /* Caption order. A short note's text leads its picture; the images
               grid is source-ordered after the body, so this is one line. */
            /* The gap between a photo and its caption belongs to the PHOTO, not
               to the body: put it on .body and a note with no images (every
               migrated one - 33 of 38) carries a phantom 16px under its date. */
            .clip { display: flex; flex-direction: column; }
            .clip .body { order: 2; }
            .clip .note-images { order: 1; margin-bottom: 0.9rem; }
            .clip.caption-leads .body { order: 1; margin-bottom: 0.9rem; }
            .clip.caption-leads .note-images { order: 2; margin-bottom: 0; }
            .note .body > :global(:first-child) { margin-top: 0; }

            .note-images { display: grid; gap: 0.4rem; margin: 0; }
            /* The mat. A photo that does not fill the column sits on a dark
               board spanning the full width, so the note keeps one edge rather
               than a ragged one - and the frame reads as a photo embed you can
               open, which is what it is. */
            .note-images .shot {
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0;
                background: var(--mat);
                border: 1px solid var(--mat-edge);
                cursor: zoom-in;
                width: 100%;
                border-radius: 10px;
                overflow: hidden;
                -webkit-tap-highlight-color: transparent;
                transition: border-color 120ms ease;
            }
            .note-images .shot:hover { border-color: var(--accent); }
            .note-images .shot:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
            /* The affordance only appears on an image the stream actually cropped -
               on a whole image it would be a lie about what the tap does. */
            .note-images .expand {
                position: absolute;
                right: 0.55rem;
                bottom: 0.55rem;
                display: none;
                align-items: center;
                gap: 0.35em;
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.68rem;
                letter-spacing: 0.02em;
                color: #f7f2e8;
                background: rgba(20, 18, 15, 0.72);
                backdrop-filter: blur(6px);
                border: 1px solid rgba(247, 242, 232, 0.22);
                border-radius: 999px;
                padding: 0.3em 0.7em;
            }
            .note-images .expand svg { width: 0.85em; height: 0.85em; }
            .note-images .shot.is-cropped .expand { display: inline-flex; }
            /* A cropped image is cut from the top - the subject of a tall photo is
               usually up there - and the gradient says there is more below. */
            .note-images .shot.is-cropped::after {
                content: '';
                position: absolute;
                inset: auto 0 0 0;
                height: 4.5rem;
                background: linear-gradient(to bottom, transparent, rgba(20, 18, 15, 0.55));
                pointer-events: none;
            }
            .note-images img {
                width: 100%; height: 100%; object-fit: cover;
                border-radius: 8px; display: block; background: var(--code-bg);
            }
            /* A single image spans the note's own column, so it reads as the
               note's subject rather than a thumbnail hung off the left margin.
               The height cap only binds on very tall crops; when it does, the
               image centres instead of sitting left. */
            .note-images.one { grid-template-columns: 1fr; }
            .note-images.one img {
                width: 100%;
                height: auto;
                object-fit: contain;
                background: none;
            }
            /* Sizing is computed per image (see sizeImages) - shrink to fit,
               then centre, then crop only when shrinking would leave the photo
               too small to see. */
            .note-images .shot img { display: block; }

            /* An embed is media too. Same board, same edge, same radius - a note
               should not present a photo one way and a video another. */
            .note .body :global(.media-mat) {
                background: var(--mat);
                border: 1px solid var(--mat-edge);
                border-radius: 10px;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 1rem 0;
            }
            .note .body :global(.media-mat iframe) { display: block; border: 0; }
            .note-images .shot.is-cropped img { object-fit: cover; object-position: top; }
            .note-images.two { grid-template-columns: 1fr 1fr; }
            .note-images.many { grid-template-columns: repeat(3, 1fr); }
            .note-images.many img { aspect-ratio: 1 / 1; }
            @media (max-width: 34rem) { .note-images.many { grid-template-columns: repeat(2, 1fr); } }

            /* Media inside a note. Uncapped, a YouTube embed makes a note the
               loudest thing on the page - louder than any post - which inverts
               the whole hierarchy. Capped, the note stays a glance. */
            #stream[data-media='cap'] .note .body :global(iframe),
            #stream[data-media='cap'] .note .body :global(img),
            #stream[data-media='cap'] .note .body :global(video) {
                max-width: 30rem;
                border-radius: 6px;
            }

            /* Without a title or an avatar, nothing says "a new note starts
               here" - a run of notes reads as one long column of prose. The
               rail becomes a timeline: a node marks each entry's start, and the
               date is promoted from a muted footnote to the note's header. */
            #stream[data-bound='node'] .note .frame { position: relative; }
            #stream[data-bound='node'] .note .meta::before {
                content: '';
                position: absolute;
                left: -1.65rem;
                top: 0.42em;
                width: 0.5rem;
                height: 0.5rem;
                border-radius: 50%;
                background: var(--accent);
                box-shadow: 0 0 0 0.28rem var(--bg);
            }
            #stream[data-bound='node'][data-note='flush'] .note .meta::before { left: -0.28rem; }
            #stream[data-bound='node'][data-note='flush'] .note .frame { padding-left: 1rem; }
            /* The dot now carries "a new entry starts here", so the date can
               step back down - as a header it was competing with the post
               titles it is supposed to sit below. */
            #stream[data-bound='node'] .note .meta .date.rel,
            #stream[data-bound='dots'] .note .meta .date.rel {
                color: var(--muted);
                font-size: 0.76em;
                letter-spacing: 0.03em;
            }

            /* A post is a bigger stop on the same timeline: an open ring rather
               than a filled dot, so the thread runs unbroken through both. */
            /* The node is drawn in three layers rather than as a bordered
               circle, because a connector that merely abuts a border can always
               show a sub-pixel seam at some zoom level - the arithmetic is
               unwinnable. Instead: a filled accent disc, the connector on top of
               it, then a background disc on top of that to punch the hollow. The
               connector starts at the disc's centre, so there is nothing to
               align: the hollow simply hides whatever it crosses.
               NOTE: `* { box-sizing: border-box }` does not match pseudo-
               elements, so --ring-outer is the true outer diameter here. */
            #stream[data-bound='node'] .post {
                --ring-outer: 1.05rem;
                --ring-b: 2px;
                --line-h: 2px;
                /* centred on the spine by construction, not by a tuned offset */
                --ring-left: calc(var(--spine-c) - var(--item-indent) - (var(--ring-outer) / 2));
                --ring-mid: calc(var(--ring-left) + (var(--ring-outer) / 2));
            }
            /* The card's own border widths, because the connector lives on
               .frame::after and is therefore positioned from the frame's
               PADDING box - one border-width down and in from where the ring
               is measured. This is what put the line half its height low. */
            #stream[data-post='card'] .post { --node-top: 1.95rem; --card-bt: 1px; --card-bl: 1px; }
            #stream[data-post='row'] .post { --node-top: 2.5rem; --card-bt: 2px; --card-bl: 0px; }
            #stream[data-bound='node'] .post::before {
                content: '';
                position: absolute;
                z-index: 1;
                left: var(--ring-left);
                top: calc(var(--node-top) - (var(--ring-outer) / 2));
                width: var(--ring-outer);
                height: var(--ring-outer);
                border-radius: 50%;
                background: var(--accent);
                box-shadow: 0 0 0 0.25rem var(--bg);
            }
            /* layer 3: the hollow, painted over the connector */
            #stream[data-bound='node'] .post::after {
                content: '';
                position: absolute;
                z-index: 3;
                left: calc(var(--ring-left) + var(--ring-b));
                top: calc(var(--node-top) - (var(--ring-outer) / 2) + var(--ring-b));
                width: calc(var(--ring-outer) - (2 * var(--ring-b)));
                height: calc(var(--ring-outer) - (2 * var(--ring-b)));
                border-radius: 50%;
                background: var(--bg);
                pointer-events: none;
            }
            #stream[data-bound='node'] .post { padding-left: 0; position: relative; }
            #stream[data-bound='node'] .post .frame { position: relative; }

            /* Attach the card to its node. Unattached, the ring reads as a
               bullet sitting beside a box; attached, the card hangs off the
               timeline. */
            #stream[data-bound='node'][data-attach='pointer'][data-post='card'] .post .frame::after {
                content: '';
                position: absolute;
                left: -1.38rem;
                top: calc(var(--node-top) - 1.15rem);
                width: 1.38rem;
                height: 1.15rem;
                border-left: 1px solid var(--branch);
                border-bottom: 1px solid var(--branch);
                border-bottom-left-radius: 1.15rem;
                pointer-events: none;
            }
            /* Accent at the node, transparent at the card: the join is implied
               rather than drawn, and nothing crosses into the ring. */
            #stream[data-bound='node'][data-attach='fade'][data-post='card'] .post .frame::after {
                content: '';
                position: absolute;
                z-index: 2;
                left: calc(var(--ring-mid) - var(--card-bl));
                top: calc(var(--node-top) - (var(--line-h) / 2) - var(--card-bt));
                width: calc(0px - var(--ring-mid) + var(--card-bl));
                height: var(--line-h);
                /* Solid until it clears the ring, then fades. The stop is the
                   disc's radius, so the gradient reads from the ring's edge. */
                background: linear-gradient(
                    to right,
                    var(--accent) 0,
                    var(--accent) calc(var(--ring-outer) / 2),
                    transparent 100%
                );
                pointer-events: none;
            }

            /* A hairline instead: a rule from the node to a squared-off corner,
               so the card looks docked rather than spoken from. */
            #stream[data-bound='node'][data-attach='stub'][data-post='card'] .post .frame::after {
                content: '';
                position: absolute;
                z-index: 2;
                left: calc(var(--ring-mid) - var(--card-bl));
                top: calc(var(--node-top) - 0.5px - var(--card-bt));
                width: calc(0px - var(--ring-mid) + var(--card-bl));
                height: 1px;
                background: var(--branch);
            }
            #stream[data-bound='node'][data-attach='stub'][data-post='card'] .post .frame {
                border-top-left-radius: 0;
            }
            /* The spine itself, drawn once behind everything. */
            #stream[data-bound='node'] {
                position: relative;
                --branch: color-mix(in srgb, var(--accent) 55%, transparent);
                --spine-x: 0.2rem;       /* spine's left edge inside the stream */
                --spine-c: calc(var(--spine-x) + 0.5px); /* its centre (1px wide) */
                --item-indent: 1.6rem;   /* how far each entry sits from it */
            }
            #stream[data-bound='node']::before {
                content: '';
                position: absolute;
                left: var(--spine-x);
                top: 0.5rem;
                bottom: 0.5rem;
                width: 1px;
                background: var(--rule);
            }
            #stream[data-bound='node'] .item { margin-left: var(--item-indent); }
            #stream[data-bound='node'][data-note='rail'] .note .frame { border-left: none; padding-left: 0; margin-left: 0; }
            #stream[data-bound='node'] .note .meta::before {
                left: calc(var(--spine-c) - var(--item-indent) - 0.25rem);
            }

            /* Meta in a left gutter: the date and tags stop interrupting the
               reading column, and a note ends up narrower than a post without
               any extra decoration saying so. Collapses on a phone, where a
               150px gutter is a quarter of the screen. */
            @media (min-width: 52rem) {
                #stream[data-meta='gutter'] .note .frame {
                    display: grid;
                    grid-template-columns: 9rem 1fr;
                    column-gap: 1.6rem;
                }
                #stream[data-meta='gutter'] .note .head { display: contents; }
                #stream[data-meta='gutter'] .note .head .right {
                    grid-column: 2;
                    grid-row: 1;
                    justify-self: end;
                }
                #stream[data-meta='gutter'] .note .meta {
                    grid-column: 1;
                    grid-row: 1;
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 0.5em;
                    margin: 0;
                    padding-top: 0.1em;
                }
                #stream[data-meta='gutter'] .note .meta .chips { flex-direction: column; align-items: flex-start; }
                #stream[data-meta='gutter'] .note .clip { grid-column: 2; grid-row: 2; }
                #stream[data-meta='gutter'] .note .actions { grid-column: 2; grid-row: 3; }
            }
            /* Consecutive notes need more air than a note next to a post does -
               that is where the blending happens. */
            #stream[data-bound='node'] .note + .note,
            #stream[data-bound='dots'] .note + .note { margin-top: 2.8rem; }
            #stream[data-bound='dots'] .note .frame { position: relative; }
            #stream[data-bound='dots'] .note .meta::before {
                content: '';
                position: absolute;
                left: -1.65rem;
                top: 0.42em;
                width: 0.5rem;
                height: 0.5rem;
                border-radius: 50%;
                background: var(--accent);
                box-shadow: 0 0 0 0.28rem var(--bg);
            }

            /* N1 - flush. Unframed, full width, hairline above. */
            #stream[data-note='flush'] .note .frame { border-top: 1px solid var(--rule); padding-top: 1.1rem; }
            #stream .item:first-child .frame { border-top: none; padding-top: 0; }
            /* N2 - inset rail. Reads as a margin annotation next to the posts. */
            #stream[data-note='rail'] .note .frame {
                border-left: 1px solid var(--rule);
                padding-left: 1.4rem;
                margin-left: 0.2rem;
            }


            /* ---------- YouTube facade ---------- */
            .note .body :global(.yt-facade) {
                position: relative;
                display: block;
                width: 100%;
                background: #000;
                border-radius: 10px;
                overflow: hidden;
                margin: 1rem 0;
                cursor: pointer;
            }
            .note .body :global(.yt-poster) {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
            .note .body :global(.yt-play) {
                position: absolute;
                inset: 0;
                margin: auto;
                width: 68px;
                height: 48px;
                background: none;
                border: none;
                padding: 0;
                cursor: pointer;
            }
            .note .body :global(.yt-play-bg) { fill: rgba(20, 18, 15, 0.72); transition: fill 120ms ease; }
            .note .body :global(.yt-play-tri) { fill: #fff; }
            .note .body :global(.yt-facade:hover .yt-play-bg) { fill: #e5350c; }
            .note .body :global(.yt-title) {
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                padding: 0.7em 0.9em 1.6em;
                color: #fff;
                font-family: var(--sans);
                font-size: 0.85rem;
                font-weight: 600;
                line-height: 1.3;
                text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
                background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent);
                pointer-events: none;
            }
            .note .body :global(iframe) { display: block; width: 100%; border: 0; border-radius: 10px; }

            /* Off-screen entries skip layout and paint entirely. The intrinsic
               size keeps the scrollbar honest while they are skipped. */
            #stream > .item {
                content-visibility: auto;
                contain-intrinsic-size: auto 420px;
            }

            /* ---------- filter behaviour ---------- */

            /* ---------- the "single entry" view + back-to-stream ---------- */
            #single {
                position: fixed;
                inset: 0;
                background: var(--bg);
                z-index: 60;
                overflow-y: auto;
                padding: 0 var(--content-pad-x) 6rem;
            }
            #single[hidden] { display: none; }
            .single-inner { max-width: var(--max-width); margin: 0 auto; }
            .backbar {
                position: sticky;
                top: 0;
                background: var(--bg);
                padding: 1rem 0;
                border-bottom: 1px solid var(--rule);
                margin-bottom: 2rem;
            }
            .single-title {
                font-family: 'Marauder', serif;
                font-weight: 800;
                font-variation-settings: 'opsz' 48;
                font-size: 2.6rem;
                line-height: 1.1;
                margin: 0 0 0.4em;
            }
            .single-kind {
                font-family: var(--sans);
                font-size: 0.68rem;
                font-weight: 700;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--muted);
                margin: 0 0 0.8rem;
            }
            /* The flash that tells you WHERE you came back to. */
            @keyframes land {
                0%, 40% { background-color: rgba(229, 120, 6, 0.16); }
                100% { background-color: transparent; }
            }
            .item.landed .frame { animation: land 1.6s ease-out; border-radius: 12px; }

            /* ---------- full-screen image viewer ---------- */
            #lightbox {
                position: fixed;
                inset: 0;
                z-index: 80;
                background: rgba(12, 11, 9, 0.94);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 3.5rem 1rem 4.5rem;
                cursor: zoom-out;
            }
            #lightbox[hidden] { display: none; }
            #lightbox img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
                border-radius: 4px;
            }
            #lightbox .lb-close,
            #lightbox .lb-nav {
                position: absolute;
                background: rgba(247, 242, 232, 0.1);
                border: 1px solid rgba(247, 242, 232, 0.2);
                color: #f7f2e8;
                border-radius: 999px;
                cursor: pointer;
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.8rem;
                padding: 0.45em 0.9em;
            }
            #lightbox .lb-close { top: 1rem; right: 1rem; }
            #lightbox .lb-nav { top: 50%; transform: translateY(-50%); padding: 0.6em 0.8em; }
            #lightbox .lb-prev { left: 0.8rem; }
            #lightbox .lb-next { right: 0.8rem; }
            #lightbox .lb-nav[hidden] { display: none; }
            #lightbox .lb-cap {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 1.2rem;
                text-align: center;
                color: var(--muted);
                font-size: 0.85rem;
                padding: 0 1.5rem;
            }

            .flag {
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.66rem;
                color: var(--accent);
                border: 1px dashed var(--accent);
                border-radius: 4px;
                padding: 0.1em 0.45em;
                opacity: 0.75;
            }
        </style>
        <style is:global>
            /* The year rail and the pager are rendered at runtime, and Astro's
               scoped styles are stamped onto elements at BUILD time - so scoped
               CSS never reaches them and they fall back to UA button chrome.
               These have to be global. */
            /* ---------- year rail ---------- */
            .stream-wrap { position: relative; }
            .years {
                overflow-x: auto;
                scrollbar-width: none;
                margin: 0 0 1.4rem;
                padding-bottom: 0.3rem;
            }
            .years::-webkit-scrollbar { display: none; }
            /* The inner span is the flex row, so the strip scrolls instead of
               wrapping onto a second line on a phone. */
            .years .years-inner { display: flex; gap: 0.3rem; width: max-content; }
            .years button {
                flex: 0 0 auto;
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.72rem;
                background: none;
                border: 1px solid transparent;
                color: var(--muted);
                border-radius: 999px;
                padding: 0.22em 0.6em;
                cursor: pointer;
            }
            .years button:hover { color: var(--fg); }
            .years button[aria-current='true'] { color: var(--accent); border-color: var(--rule); }
            .years button[aria-pressed='true'] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
            @media (min-width: 64rem) {
                .years {
                    position: absolute;
                    left: -7.5rem;
                    top: 0;
                    bottom: 0;
                    width: 6.5rem;
                    margin: 0;
                    display: block;
                    overflow: visible;
                }
                .years .years-inner {
                    position: sticky;
                    top: 1.5rem;
                    display: flex;
                    flex-direction: column;
                    align-items: flex-end;
                    gap: 0.12rem;
                    max-height: calc(100vh - 3rem);
                    overflow-y: auto;
                    scrollbar-width: none;
                }
                .years button { width: 100%; text-align: right; }
            }

            /* ---------- pagination ---------- */
            .pager {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.4rem;
                margin: 2.6rem 0 0;
                padding-top: 1.4rem;
                border-top: 1px solid var(--rule);
                flex-wrap: wrap;
            }
            .pager button {
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.75rem;
                background: none;
                border: 1px solid var(--rule);
                color: var(--muted);
                border-radius: 6px;
                padding: 0.3em 0.7em;
                cursor: pointer;
            }
            .pager button:hover:not(:disabled) { color: var(--fg); border-color: var(--muted); }
            .pager button[aria-current='true'] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
            .pager button:disabled { opacity: 0.35; cursor: default; }
            .pager .range {
                font-family: 'DraftingMono', ui-monospace, monospace;
                font-size: 0.7rem;
                color: var(--muted);
                margin-right: 0.5rem;
            }

        </style>
    </head>
    <body>
        <main>
            <section class="lab">
                <h1>Specimen · notes rollout · real content, nothing shipped</h1>
                <div class="knobs">
                    <span class="knob"
                        ><span>post</span>
                        <button data-set="post" data-val="card" aria-pressed="true">card</button>
                        <button data-set="post" data-val="row" aria-pressed="false">heavy row</button>
                    </span>
                    <span class="knob"
                        ><span>note</span>
                        <button data-set="note" data-val="flush" aria-pressed="true">flush</button>
                        <button data-set="note" data-val="rail" aria-pressed="false">inset rail</button>
                    </span>
                    <span class="knob"
                        ><span>multi-video</span>
                        <button data-set="split" data-val="split" aria-pressed="true">one note each</button>
                        <button data-set="split" data-val="keep" aria-pressed="false">keep together</button>
                    </span>
                    <span class="knob"
                        ><span>timeline</span>
                        <button data-set="bound" data-val="node" aria-pressed="true">dots + rings</button>
                        <button data-set="bound" data-val="dots" aria-pressed="false">notes only</button>
                        <button data-set="bound" data-val="plain" aria-pressed="false">off</button>
                    </span>
                    <span class="knob"
                        ><span>card attach</span>
                        <button data-set="attach" data-val="fade" aria-pressed="true">fading stub</button>
                        <button data-set="attach" data-val="pointer" aria-pressed="false">curve</button>
                        <button data-set="attach" data-val="stub" aria-pressed="false">hairline</button>
                        <button data-set="attach" data-val="plain" aria-pressed="false">plain</button>
                    </span>
                    <span class="knob"
                        ><span>note meta</span>
                        <button data-set="meta" data-val="gutter" aria-pressed="true">left gutter</button>
                        <button data-set="meta" data-val="inline" aria-pressed="false">inline</button>
                    </span>
                    <span class="knob"
                        ><span>note media</span>
                        <button data-set="media" data-val="cap" aria-pressed="true">capped</button>
                        <button data-set="media" data-val="full" aria-pressed="false">full width</button>
                    </span>
                    <span class="knob"
                        ><span>theme</span>
                        <button data-theme-set="dark" aria-pressed="true">dark</button>
                        <button data-theme-set="light" aria-pressed="false">light</button>
                    </span>
                </div>
            </section>

            <details class="brief">
                <summary>What you&rsquo;re looking at</summary>
                <p class="note-to-self">
                The stream below is your actual corpus under the proposed split: {postCount} posts,
                {noteCount} notes. Migrated notes have had their titles dropped, as decided. Posts show
                a 2&ndash;3 block excerpt and always offer <em>Read post</em>; notes render in full,
                clamped on prose, and limited to one embed, with <em>Show more</em>. Both carry a share action. Opening either one
                and coming back demonstrates the return-to-place behaviour. Entries marked
                <span class="flag">judgment</span> are the two where word count and character disagree.
                </p>
            </details>

            <div class="filter" role="group" aria-label="Filter entries">
                <button data-filter="all" aria-pressed="true">Everything <span class="count">{items.length}</span></button>
                <button data-filter="post" aria-pressed="false">Posts <span class="count">{postCount}</span></button>
                <button data-filter="note" aria-pressed="false">Notes <span class="count">{noteCount}</span></button>
            </div>

            <div class="stream-wrap">
            <nav class="years" id="years" aria-label="Jump to year"><span class="years-inner" id="years-inner"></span></nav>
            <div id="stream" data-post="card" data-note="flush" data-media="cap" data-bound="node" data-meta="gutter" data-attach="fade" data-split="split" data-showing="all">
                {
                    items.map((item) => (
                        <article
                            class:list={['item', item.kind]}
                            id={`e-${item.slug}`}
                            data-kind={item.kind}
                            data-slug={item.slug}
                            data-href={item.href}
                            data-year={item.date.getUTCFullYear()}
                        >
                            <div class="frame">
                                {item.kind === 'post' ? (
                                    <>
                                        <h2 class="p-title">
                                            <a href={item.href} data-open>
                                                {item.title}
                                            </a>
                                        </h2>
                                        <div class="meta">
                                            <time
                                                class="date rel"
                                                datetime={item.date.toISOString()}
                                                title={absolute(item.date)}
                                                data-abs={absolute(item.date)}
                                                tabindex="0"
                                            >
                                                <FormattedDate date={item.date} />
                                            </time>
                                            {item.tags.length > 0 && (
                                                <span class="chips">
                                                    {item.tags.map((t) => (
                                                        <span class="chip">{t}</span>
                                                    ))}
                                                </span>
                                            )}
                                        </div>
                                        <div class="prose excerpt">
                                            <item.Content />
                                        </div>
                                        <div class="actions">
                                            <a class="act cta" href={item.href} data-open>
                                                Read post <span class="arrow">&rarr;</span>
                                            </a>
                                            <span class="right">
                                            <button class="act share" type="button">
                                                Share
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1 0l3-3A5 5 0 0 0 13 3l-1 1"/><path d="M14 11a5 5 0 0 0-7.1 0l-3 3A5 5 0 0 0 11 21l1-1"/></svg>
                                            </button>
                                            </span>
                                        </div>
                                    </>
                                ) : (
                                    <>
                                        <div class="head">
                                            <div class="meta">
                                                <time
                                                    class="date rel"
                                                    datetime={item.date.toISOString()}
                                                    title={absolute(item.date)}
                                                    data-abs={absolute(item.date)}
                                                    tabindex="0"
                                                >
                                                    <FormattedDate date={item.date} />
                                                </time>
                                                {item.demo && <span class="flag">demo image</span>}
                                                {item.tags.length > 0 && (
                                                    <span class="chips">
                                                        {item.tags.map((t) => (
                                                            <span class="chip">{t}</span>
                                                        ))}
                                                    </span>
                                                )}
                                            </div>
                                            <span class="right">
                                                <a class="act" href={item.href} data-open>
                                                    <span class="lead">&rsaquo;</span> Open note
                                                </a>
                                                <button class="act share" type="button">
                                                    Share
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1 0l3-3A5 5 0 0 0 13 3l-1 1"/><path d="M14 11a5 5 0 0 0-7.1 0l-3 3A5 5 0 0 0 11 21l1-1"/></svg>
                                                </button>
                                            </span>
                                        </div>
                                        <div class:list={['clip', { 'caption-leads': item.captionLeads }]}>
                                            <div class="prose body">
                                                {item.html ? (
                                                    <Fragment set:html={item.html} />
                                                ) : (
                                                    <item.Content />
                                                )}
                                            </div>
                                            {item.images.length > 0 && (
                                                <div
                                                    class:list={[
                                                        'note-images',
                                                        item.images.length === 1
                                                            ? 'one'
                                                            : item.images.length === 2
                                                              ? 'two'
                                                              : 'many',
                                                    ]}
                                                >
                                                    {item.images.map((img) => (
                                                        <button class="shot" type="button">
                                                            <img
                                                                src={img.src}
                                                                srcset={srcSet(img.src)}
                                                                sizes="(max-width: 40rem) 100vw, 44rem"
                                                                alt={img.alt ?? ''}
                                                                loading="lazy"
                                                                decoding="async"
                                                            />
                                                            <span class="expand">
                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                                                                Full size
                                                            </span>
                                                        </button>
                                                    ))}
                                                </div>
                                            )}
                                        </div>
                                        <div class="actions">
                                            <button class="act more" type="button">Show more</button>
                                        </div>
                                    </>
                                )}
                            </div>
                        </article>
                    ))
                }
            </div>
            <nav class="pager" id="pager" aria-label="Pagination"></nav>
            </div>
        </main>

        <div id="lightbox" hidden>
            <button class="lb-close" type="button">Close &times;</button>
            <button class="lb-nav lb-prev" type="button" aria-label="Previous image">&lsaquo;</button>
            <img id="lb-img" src="" alt="" />
            <button class="lb-nav lb-next" type="button" aria-label="Next image">&rsaquo;</button>
            <p class="lb-cap" id="lb-cap"></p>
        </div>

        <div id="single" hidden>
            <div class="single-inner">
                <div class="backbar">
                    <button class="act" id="back" type="button">&larr; Back to everything</button>
                </div>
                <p class="single-kind" id="single-kind"></p>
                <h1 class="single-title" id="single-title"></h1>
                <div class="prose" id="single-body"></div>
            </div>
        </div>

        <script>
            const stream = document.getElementById('stream')!;

            // Knob state survives a reload (and a republish): the URL wins if it
            // carries one, otherwise whatever was last picked here.
            const KNOBS = ['post', 'note', 'media', 'bound', 'split', 'meta', 'attach'];
            const STORE = 'specimen-knobs-v1';
            let saved: Record<string, string> = {};
            try {
                saved = JSON.parse(localStorage.getItem(STORE) || '{}');
            } catch {}
            const qs = new URLSearchParams(location.search);
            for (const key of KNOBS) {
                const v = qs.get(key) || saved[key];
                if (!v) continue;
                stream.dataset[key] = v;
                document
                    .querySelectorAll<HTMLButtonElement>(`[data-set="${key}"]`)
                    .forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.val === v)));
            }

            // ---- specimen knobs ----
            document.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => {
                b.addEventListener('click', () => {
                    const key = b.dataset.set!;
                    stream.dataset[key] = b.dataset.val!;
                    document
                        .querySelectorAll<HTMLButtonElement>(`[data-set="${key}"]`)
                        .forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
                    try {
                        const next = { ...saved, [key]: b.dataset.val! };
                        saved = next;
                        localStorage.setItem(STORE, JSON.stringify(next));
                    } catch {}
                    page = 1;
                    applyView({ keepScroll: true });
                    measure();
                });
            });
            document.querySelectorAll<HTMLButtonElement>('[data-theme-set]').forEach((b) => {
                b.addEventListener('click', () => {
                    document.documentElement.dataset.theme = b.dataset.themeSet!;
                    try { localStorage.setItem('specimen-theme', b.dataset.themeSet!); } catch {}
                    document
                        .querySelectorAll<HTMLButtonElement>('[data-theme-set]')
                        .forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
                });
            });

            function recount() {
                const split = stream.dataset.split;
                const pool = (Array.from(stream.children) as HTMLElement[]).filter((el) => {
                    if (split === 'split' && el.classList.contains('was-multi')) return false;
                    if (split === 'keep' && el.classList.contains('split-part')) return false;
                    return year === 'all' || el.dataset.year === year;
                });
                const notes = pool.filter((e) => e.dataset.kind === 'note').length;
                const posts = pool.filter((e) => e.dataset.kind === 'post').length;
                const set = (f: string, n: number) => {
                    const el = document.querySelector(`[data-filter="${f}"] .count`);
                    if (el) el.textContent = String(n);
                };
                set('note', notes);
                set('post', posts);
                set('all', notes + posts);
            }

            try {
                const th = localStorage.getItem('specimen-theme');
                if (th) {
                    document.documentElement.dataset.theme = th;
                    document
                        .querySelectorAll<HTMLButtonElement>('[data-theme-set]')
                        .forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.themeSet === th)));
                }
            } catch {}

            // ---- one view: kind filter x year x page ----
            // A year behaves exactly like the /posts/YYYY/ route would, and the
            // page slice like /posts/page/N. Doing it client-side here keeps the
            // specimen one file; the real thing is Astro's paginate().
            const PER_PAGE = 20;
            const pager = document.getElementById('pager')!;
            const yearsInner = document.getElementById('years-inner')!;
            let page = 1;
            let year = 'all';

            const allItems = () => Array.from(stream.children) as HTMLElement[];
            function eligible() {
                const showing = stream.dataset.showing;
                const split = stream.dataset.split;
                return allItems().filter((el) => {
                    if (split === 'split' && el.classList.contains('was-multi')) return false;
                    if (split === 'keep' && el.classList.contains('split-part')) return false;
                    if (showing !== 'all' && el.dataset.kind !== showing) return false;
                    if (year !== 'all' && el.dataset.year !== year) return false;
                    return true;
                });
            }

            function renderPager(total: number, pages: number) {
                if (pages <= 1) { pager.innerHTML = ''; return; }
                const from = (page - 1) * PER_PAGE + 1;
                const to = Math.min(page * PER_PAGE, total);
                const btn = (label: string, p: number, opts: { cur?: boolean; dis?: boolean } = {}) =>
                    `<button data-page="${p}"${opts.cur ? ' aria-current="true"' : ''}${opts.dis ? ' disabled' : ''}>${label}</button>`;
                let html = `<span class="range">${from}&ndash;${to} of ${total}</span>`;
                html += btn('&larr; Newer', page - 1, { dis: page === 1 });
                for (let p = 1; p <= pages; p++) html += btn(String(p), p, { cur: p === page });
                html += btn('Older &rarr;', page + 1, { dis: page === pages });
                pager.innerHTML = html;
            }

            function applyView(opts: { keepScroll?: boolean } = {}) {
                const list = eligible();
                const pages = Math.max(1, Math.ceil(list.length / PER_PAGE));
                page = Math.min(Math.max(1, page), pages);
                const slice = new Set(list.slice((page - 1) * PER_PAGE, page * PER_PAGE));
                allItems().forEach((el) => { el.style.display = slice.has(el) ? '' : 'none'; });
                renderPager(list.length, pages);
                recount();
                if (!opts.keepScroll) window.scrollTo({ top: 0 });
                measure();
                sizeImages();
                sizeEmbeds();
            }

            pager.addEventListener('click', (e) => {
                const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-page]');
                if (!b || b.disabled) return;
                page = Number(b.dataset.page);
                applyView();
            });

            // ---- year rail ----
            const years = [...new Set(allItems().map((el) => el.dataset.year!))].sort().reverse();
            yearsInner.innerHTML =
                `<button data-year="all">all</button>` +
                years.map((y) => `<button data-year="${y}">${y}</button>`).join('');
            yearsInner.addEventListener('click', (e) => {
                const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-year]');
                if (!b) return;
                const next = b.dataset.year!;
                if (next !== 'all' && year === 'all') {
                    // Same year already on this page? Scroll to it rather than
                    // navigating away - the rail should feel like a jump first.
                    const hit = eligible().find(
                        (el) => el.dataset.year === next && el.style.display !== 'none',
                    );
                    if (hit) {
                        hit.scrollIntoView({ block: 'start' });
                        return;
                    }
                }
                year = next;
                page = 1;
                applyView();
                syncYearButtons();
            });
            function syncYearButtons() {
                yearsInner.querySelectorAll<HTMLButtonElement>('[data-year]').forEach((b) => {
                    b.setAttribute('aria-pressed', String(year !== 'all' && b.dataset.year === year));
                });
            }

            // Scroll-spy: highlight whichever year is currently in view.
            const spy = new IntersectionObserver(
                (entries) => {
                    if (year !== 'all') return;
                    const seen = entries
                        .filter((e) => e.isIntersecting)
                        .map((e) => (e.target as HTMLElement).dataset.year!);
                    if (!seen.length) return;
                    const cur = seen.sort().reverse()[0];
                    yearsInner.querySelectorAll<HTMLButtonElement>('[data-year]').forEach((b) => {
                        b.setAttribute('aria-current', String(b.dataset.year === cur));
                    });
                },
                { rootMargin: '-25% 0px -60% 0px' },
            );
            allItems().forEach((el) => spy.observe(el));

            // ---- reader filter ----
            document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
                b.addEventListener('click', () => {
                    stream.dataset.showing = b.dataset.filter!;
                    document
                        .querySelectorAll<HTMLButtonElement>('[data-filter]')
                        .forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
                    page = 1;
                    applyView();
                });
            });

            // ---- post excerpts: 2-3 blocks, by length, never ending on a heading ----
            const WORD_TARGET = 110;
            document.querySelectorAll<HTMLElement>('.post .excerpt').forEach((ex) => {
                const blocks = Array.from(ex.children) as HTMLElement[];
                const isHeading = (el: Element) => /^H[1-6]$/.test(el.tagName);
                let words = 0;
                let keep = 0;
                for (const b of blocks) {
                    keep++;
                    words += (b.textContent || '').trim().split(/\s+/).filter(Boolean).length;
                    if (keep >= 2 && words >= WORD_TARGET) break;
                    if (keep >= 3) break;
                }
                while (keep > 1 && isHeading(blocks[keep - 1])) keep--;
                blocks.forEach((b, i) => {
                    if (i >= keep) b.style.display = 'none';
                });
            });

            // ---- note clamping ----
            const PROSE_MAX = 20 * 16;
            const hasMedia = (el: Element) => !!el.querySelector('img, iframe, video') || /^(IMG|IFRAME|VIDEO)$/.test(el.tagName);
            function measure() {
                document.querySelectorAll<HTMLElement>('.note').forEach((n) => {
                    if (n.classList.contains('is-open')) return;
                    n.classList.remove('is-clamped');
                    const body = n.querySelector<HTMLElement>('.body');
                    if (!body) return;
                    // Only prose counts toward the clamp. A note that is one photo
                    // and a sentence is complete; a note that is a pasted wall of
                    // text is not.
                    let prose = 0;
                    for (const child of Array.from(body.children)) {
                        if (hasMedia(child)) continue;
                        prose += (child as HTMLElement).offsetHeight;
                    }
                    n.classList.toggle('is-clamped', prose > PROSE_MAX);

                    // Media limit, counted separately from prose.
                    const media = Array.from(body.children).filter(hasMedia) as HTMLElement[];
                    media.forEach((el, i) => el.classList.toggle('media-extra', i > 0));
                    n.classList.toggle('is-media-clamped', media.length > 1);
                    const btn = n.querySelector<HTMLButtonElement>('.more');
                    if (btn && media.length > 1) {
                        const n_ = media.length - 1;
                        btn.dataset.openLabel = `Show ${n_} more ${n_ === 1 ? 'video' : 'videos'}`;
                    }
                });
                document.querySelectorAll<HTMLButtonElement>('.note .more').forEach((b) => {
                    const note = b.closest('.note')!;
                    if (note.classList.contains('is-open')) return;
                    b.textContent = b.dataset.openLabel || 'Show more';
                });
            }
            measure();
            window.addEventListener('load', measure);
            document.querySelectorAll<HTMLButtonElement>('.note .more').forEach((b) => {
                b.addEventListener('click', () => {
                    const note = b.closest('.note')!;
                    const opening = !note.classList.contains('is-open');
                    note.classList.toggle('is-open', opening);
                    note.classList.toggle('is-media-clamped', !opening);
                    if (opening) note.classList.remove('is-clamped');
                    else measure();
                    b.textContent = opening ? 'Show less' : b.dataset.openLabel || 'Show more';
                    if (!opening) note.scrollIntoView({ block: 'nearest' });
                });
            });

            // ---- multi-video notes: one note per video ----
            // Eight migrated notes are a batch of videos under headings, and in
            // the LRK ones those headings are sequential devlog beats
            // ("Adventure - Update #1..#5") that were only ever batched because
            // a post was the smallest unit available. Split, each beat is its
            // own note. Both versions live in the DOM; the knob picks one.
            const isMedia = (el: Element) => !!el.querySelector('img, iframe, video') || /^(IMG|IFRAME|VIDEO)$/.test(el.tagName);
            document.querySelectorAll<HTMLElement>('.item.note').forEach((note) => {
                const body = note.querySelector<HTMLElement>('.body');
                if (!body) return;
                const kids = Array.from(body.children) as HTMLElement[];
                const mediaIdx = kids.map((el, i) => (isMedia(el) ? i : -1)).filter((i) => i >= 0);
                if (mediaIdx.length < 2) return;

                // A segment is the video plus the heading that introduces it.
                const starts = mediaIdx.map((i) =>
                    i > 0 && /^H[1-6]$/.test(kids[i - 1].tagName) ? i - 1 : i,
                );
                const preamble = kids.slice(0, starts[0]);

                note.classList.add('was-multi');
                let anchor: HTMLElement = note;
                starts.forEach((start, n) => {
                    const end = n + 1 < starts.length ? starts[n + 1] : kids.length;
                    const part = note.cloneNode(true) as HTMLElement;
                    part.classList.remove('was-multi');
                    part.classList.add('split-part');
                    part.id = `${note.id}-${n + 1}`;
                    part.dataset.slug = `${note.dataset.slug}-${n + 1}`;
                    part.dataset.href = note.dataset.href!.replace(/\/$/, `-${n + 1}/`);
                    const pb = part.querySelector<HTMLElement>('.body')!;
                    const pk = Array.from(pb.children) as HTMLElement[];
                    pb.replaceChildren(
                        ...(n === 0 ? preamble.map((_, i) => pk[i]) : []),
                        ...pk.slice(start, end),
                    );
                    anchor.after(part);
                    anchor = part;
                });
            });

            recount();

            // ---- notes: drop a heading the embed under it already says ----
            // These migrated notes were structured like posts: "### Update #1"
            // above a video whose own player reads "zSprite - Update #1". In a
            // post that scaffolding earns its place; in a note it is the same
            // sentence twice, and it is what makes a note look like a document.
            // Only a heading the following embed demonstrably repeats is dropped
            // - a heading that says something new survives.
            const norm = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, '');
            let stripped = 0;
            document.querySelectorAll<HTMLElement>('.note .body').forEach((body) => {
                const kids = Array.from(body.children) as HTMLElement[];
                kids.forEach((el, i) => {
                    if (!/^H[1-6]$/.test(el.tagName)) return;
                    const next = kids[i + 1];
                    if (!next) return;
                    const frame = next.matches('iframe') ? next : next.querySelector('iframe');
                    if (!frame) return;
                    const embedTitle = norm(frame.getAttribute('title') || '');
                    const heading = norm(el.textContent || '');
                    if (heading && embedTitle.includes(heading)) {
                        el.remove();
                        stripped++;
                    }
                });
            });
            if (stripped) console.info(`specimen: dropped ${stripped} redundant note heading(s)`);

            // ---- crop detection + full-screen viewer ----
            // An image may take at most 66% of the viewport height, so the note
            // it belongs to never fills the screen on its own and the page stays
            // connected. Three steps, in order of how much they cost the reader:
            //   1. fits already          -> full column width, untouched
            //   2. too tall             -> shrink and centre, still the whole image
            //   3. shrinking made it small -> stop shrinking, crop to the floor width
            const VH_CAP = 0.66;
            const MIN_WIDTH_FRACTION = 0.62; // never shrink below this much of the mat
            const CAP_PX = 24 * 16; // 'capped' note media
            function sizeImage(img: HTMLImageElement) {
                if (!img.naturalWidth) return;
                const shot = img.closest<HTMLElement>('.shot')!;
                const grid = shot.parentElement!;
                if (!grid.classList.contains('one')) return; // grids are already small
                const matW = grid.clientWidth;
                if (!matW) return;
                const maxW = stream.dataset.media === 'cap' ? Math.min(matW, CAP_PX) : matW;
                const cap = window.innerHeight * VH_CAP;
                const ratio = img.naturalHeight / img.naturalWidth;

                shot.classList.remove('is-cropped');
                let w = maxW;
                let h = maxW * ratio;

                if (h > cap) {
                    const shrunkW = cap / ratio;
                    if (shrunkW >= maxW * MIN_WIDTH_FRACTION) {
                        w = shrunkW; // step 2: shrink, still whole
                        h = cap;
                    } else {
                        w = maxW * MIN_WIDTH_FRACTION; // step 3: hold the floor, crop
                        h = cap;
                        shot.classList.add('is-cropped');
                    }
                }

                // The mat spans the column; the photo sits centred on it.
                shot.style.height = `${Math.round(h)}px`;
                img.style.width = `${Math.round(w)}px`;
                img.style.height = `${Math.round(h)}px`;
            }
            // Give every embed in a note the photo's frame.
            document.querySelectorAll<HTMLElement>('.note .body').forEach((body) => {
                body.querySelectorAll('iframe').forEach((f) => {
                    if (f.parentElement?.classList.contains('media-mat')) return;
                    const mat = document.createElement('div');
                    mat.className = 'media-mat';
                    f.replaceWith(mat);
                    mat.appendChild(f);
                });
            });
            function sizeEmbeds() {
                const cap = window.innerHeight * VH_CAP;
                document.querySelectorAll<HTMLElement>('.note .media-mat').forEach((mat) => {
                    const f = mat.querySelector('iframe') as HTMLIFrameElement | null;
                    if (!f) return;
                    const w = mat.clientWidth;
                    if (!w) return;
                    // A video needs width to be watchable, so it fills the board
                    // rather than obeying the photo width cap - but it still
                    // answers to the same height ceiling.
                    const h = Math.min((w * 9) / 16, cap);
                    f.style.width = `${Math.round((h * 16) / 9)}px`;
                    f.style.height = `${Math.round(h)}px`;
                    f.style.maxWidth = '100%';
                });
            }

            function sizeImages() {
                document
                    .querySelectorAll<HTMLImageElement>('.note-images img')
                    .forEach((img) => {
                        if (img.complete) sizeImage(img);
                        else img.addEventListener('load', () => { sizeImage(img); measure(); }, { once: true });
                    });
            }
            sizeImages();
            sizeEmbeds();
            let rz: number;
            window.addEventListener('resize', () => {
                clearTimeout(rz);
                rz = window.setTimeout(() => { sizeImages(); sizeEmbeds(); measure(); }, 150);
            });

            const lb = document.getElementById('lightbox')!;
            const lbImg = document.getElementById('lb-img') as HTMLImageElement;
            const lbCap = document.getElementById('lb-cap')!;
            const prevBtn = lb.querySelector<HTMLButtonElement>('.lb-prev')!;
            const nextBtn = lb.querySelector<HTMLButtonElement>('.lb-next')!;
            let group: HTMLImageElement[] = [];
            let idx = 0;

            function paint() {
                const img = group[idx];
                lbImg.src = img.src;
                lbImg.alt = img.alt;
                lbCap.textContent =
                    (img.alt || '') + (group.length > 1 ? `  (${idx + 1}/${group.length})` : '');
                prevBtn.hidden = group.length < 2;
                nextBtn.hidden = group.length < 2;
            }
            function openLb(img: HTMLImageElement) {
                group = Array.from(
                    img.closest('.note-images')!.querySelectorAll<HTMLImageElement>('img'),
                );
                idx = group.indexOf(img);
                paint();
                lb.hidden = false;
                document.body.style.overflow = 'hidden';
            }
            function closeLb() {
                lb.hidden = true;
                if (document.getElementById('single')!.hidden) document.body.style.overflow = '';
            }
            document.querySelectorAll<HTMLButtonElement>('.note-images .shot').forEach((b) => {
                b.addEventListener('click', () => openLb(b.querySelector('img')!));
            });
            lb.addEventListener('click', (e) => {
                if (e.target === lb || e.target === lbImg) closeLb();
            });
            lb.querySelector('.lb-close')!.addEventListener('click', closeLb);
            prevBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                idx = (idx - 1 + group.length) % group.length;
                paint();
            });
            nextBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                idx = (idx + 1) % group.length;
                paint();
            });
            document.addEventListener('keydown', (e) => {
                if (lb.hidden) return;
                if (e.key === 'Escape') closeLb();
                if (e.key === 'ArrowLeft') prevBtn.click();
                if (e.key === 'ArrowRight') nextBtn.click();
            });

            // ---- facade -> real player, only on demand ----
            document.addEventListener('click', (e) => {
                const facade = (e.target as HTMLElement).closest<HTMLElement>('.yt-facade');
                if (!facade) return;
                const id = facade.dataset.yt;
                if (!id) return;
                const f = document.createElement('iframe');
                f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
                f.title = facade.dataset.ytTitle || 'Video';
                f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                f.allowFullscreen = true;
                f.style.cssText = 'width:100%;aspect-ratio:16/9;border:0;border-radius:10px;display:block';
                facade.replaceWith(f);
            });

            // ---- relative timestamps ----
            // Rendered absolute so a no-JS reader still gets a real date, then
            // swapped to relative. Hover shows the absolute (title); tap toggles
            // it inline, because phones have no hover.
            const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
            const UNITS: [Intl.RelativeTimeFormatUnit, number][] = [
                ['year', 365 * 24 * 3600],
                ['month', 30 * 24 * 3600],
                ['week', 7 * 24 * 3600],
                ['day', 24 * 3600],
                ['hour', 3600],
                ['minute', 60],
            ];
            function relative(iso: string): string {
                const secs = (Date.parse(iso) - Date.now()) / 1000;
                const abs = Math.abs(secs);
                if (abs < 60) return 'just now';
                for (const [unit, size] of UNITS) {
                    if (abs >= size) return rtf.format(Math.round(secs / size), unit);
                }
                return 'just now';
            }
            document.querySelectorAll<HTMLTimeElement>('time.rel').forEach((t) => {
                const abs = t.dataset.abs!;
                const rel = relative(t.dateTime);
                t.textContent = rel;
                t.addEventListener('click', () => {
                    const showingRel = t.textContent === rel;
                    t.textContent = showingRel ? abs : rel;
                });
            });

            // ---- share ----
            document.querySelectorAll<HTMLButtonElement>('.share').forEach((b) => {
                b.addEventListener('click', async () => {
                    const item = b.closest<HTMLElement>('.item')!;
                    const url = new URL(item.dataset.href!, location.origin).href;
                    try {
                        await navigator.clipboard.writeText(url);
                    } catch {}
                    const label = b.lastChild!;
                    label.textContent = ' Link copied';
                    b.classList.add('copied');
                    setTimeout(() => {
                        label.textContent = ' Share';
                        b.classList.remove('copied');
                    }, 1600);
                });
            });

            // ---- open a single entry / come back to where you were ----
            const single = document.getElementById('single')!;
            const sBody = document.getElementById('single-body')!;
            const sTitle = document.getElementById('single-title')!;
            const sKind = document.getElementById('single-kind')!;
            let fromSlug: string | null = null;
            let fromScroll = 0;

            document.querySelectorAll<HTMLElement>('[data-open]').forEach((a) => {
                a.addEventListener('click', (e) => {
                    e.preventDefault();
                    const item = a.closest<HTMLElement>('.item')!;
                    fromSlug = item.dataset.slug!;
                    fromScroll = window.scrollY;
                    const isPost = item.dataset.kind === 'post';
                    sKind.textContent = isPost ? 'Post' : 'Note';
                    sTitle.textContent = isPost
                        ? item.querySelector('.p-title')!.textContent!.trim()
                        : '';
                    sTitle.style.display = isPost ? '' : 'none';
                    const src = item.querySelector('.excerpt, .body')!;
                    sBody.innerHTML = src.innerHTML;
                    sBody.querySelectorAll<HTMLElement>('*').forEach((el) => (el.style.display = ''));
                    single.hidden = false;
                    document.body.style.overflow = 'hidden';
                    single.scrollTop = 0;
                });
            });

            syncYearButtons();
            applyView({ keepScroll: true });

            document.getElementById('back')!.addEventListener('click', () => {
                single.hidden = true;
                document.body.style.overflow = '';
                window.scrollTo({ top: fromScroll });
                if (fromSlug) {
                    const el = document.getElementById(`e-${fromSlug}`);
                    if (el) {
                        el.classList.remove('landed');
                        void el.offsetWidth;
                        el.classList.add('landed');
                    }
                }
            });
        </script>
    </body>
</html>
