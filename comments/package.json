{
  "name": "log-comments",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Comments backend for log.fisher.sh - a Cloudflare Worker + D1. Bluesky OAuth for identity, comments owned in D1. Deployed via nottingham-cloud make targets.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply log-comments --local",
    "migrate:remote": "wrangler d1 migrations apply log-comments --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/oauth-client": "^0.6.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
